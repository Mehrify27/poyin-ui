+		tb.reloadIfChanged()
+
+		if tb.lookup("k1@x", nil) != l {
+			t.Fatal("Limits was replaced")
+		}
+		for i := 2; i <= 6; i++ {
+			dial(t, tb, "k1@x", fmt.Sprintf("198.51.100.%d", i))
+		}
