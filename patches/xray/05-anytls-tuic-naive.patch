--- /dev/null
+++ b/proxy/anytls/config.proto
@@ -0,0 +1,44 @@
+syntax = "proto3";
+
+package xray.proxy.anytls;
+option csharp_namespace = "Xray.Proxy.Anytls";
+option go_package = "github.com/xtls/xray-core/proxy/anytls";
+option java_package = "com.xray.proxy.anytls";
+option java_multiple_files = true;
+
+import "common/net/address.proto";
+import "common/protocol/user.proto";
+
+message Account {
+  string password = 1;
+}
+
+message Fallback {
+  string name = 1;
+  string alpn = 2;
+  string path = 3;
+  string type = 4;
+  string dest = 5;
+  uint64 xver = 6;
+}
+
+message ServerConfig {
+  repeated xray.common.protocol.User users = 1;
+  // Raw padding scheme, newline separated. Empty means the library default.
+  string padding_scheme = 2;
+  repeated Fallback fallbacks = 3;
+}
+
+message ClientConfig {
+  xray.common.net.IPOrDomain address = 1;
+  uint32 port = 2;
+  string password = 3;
+  string email = 4;
+  int32 level = 5;
+  // Seconds. Zero means the library default.
+  uint32 idle_session_check_interval = 6;
+  // Seconds. Zero means the library default.
+  uint32 idle_session_timeout = 7;
+  int32 min_idle_session = 8;
+  bool disable_reuse = 9;
+}
diff --git a/proxy/anytls/fallback.go b/proxy/anytls/fallback.go
new file mode 100644
index 00000000..d825d1af
--- /dev/null
+++ b/proxy/anytls/fallback.go
@@ -0,0 +1,309 @@
+package anytls
+
+import (
+	"context"
+	"strconv"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/retry"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/common/task"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/transport/internet/reality"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+var _ N.TCPConnectionHandlerEx = (*fallbackHandler)(nil)
+
+// fallbackHandler is handed to the anytls service as its FallbackHandler, so a
+// connection that fails authentication is relayed to a masquerade site instead
+// of being dropped. The conn it receives replays the client's bytes from the
+// very first one, so from here on this is the same job trojan's fallback does.
+type fallbackHandler struct {
+	inbound *Inbound
+}
+
+func (h *fallbackHandler) NewConnectionEx(ctx context.Context, conn net.Conn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	err := h.inbound.fallback(ctx, conn)
+	if err != nil && !E.IsClosedOrCanceled(err) {
+		errors.LogInfo(ctx, "anytls fallback: ", err.Error())
+	}
+	if onClose != nil {
+		onClose(err)
+	}
+}
+
+func buildFallbacks(configured []*Fallback) map[string]map[string]map[string]*Fallback {
+	if len(configured) == 0 {
+		return nil
+	}
+
+	fallbacks := make(map[string]map[string]map[string]*Fallback)
+	for _, fb := range configured {
+		if fallbacks[fb.Name] == nil {
+			fallbacks[fb.Name] = make(map[string]map[string]*Fallback)
+		}
+		if fallbacks[fb.Name][fb.Alpn] == nil {
+			fallbacks[fb.Name][fb.Alpn] = make(map[string]*Fallback)
+		}
+		fallbacks[fb.Name][fb.Alpn][fb.Path] = fb
+	}
+	if fallbacks[""] != nil {
+		for name, apfb := range fallbacks {
+			if name != "" {
+				for alpn := range fallbacks[""] {
+					if apfb[alpn] == nil {
+						apfb[alpn] = make(map[string]*Fallback)
+					}
+				}
+			}
+		}
+	}
+	for _, apfb := range fallbacks {
+		if apfb[""] != nil {
+			for alpn, pfb := range apfb {
+				if alpn != "" {
+					for path, fb := range apfb[""] {
+						if pfb[path] == nil {
+							pfb[path] = fb
+						}
+					}
+				}
+			}
+		}
+	}
+	if fallbacks[""] != nil {
+		for name, apfb := range fallbacks {
+			if name != "" {
+				for alpn, pfb := range fallbacks[""] {
+					for path, fb := range pfb {
+						if apfb[alpn][path] == nil {
+							apfb[alpn][path] = fb
+						}
+					}
+				}
+			}
+		}
+	}
+	return fallbacks
+}
+
+func (i *Inbound) fallback(ctx context.Context, connection net.Conn) error {
+	napfb := i.fallbacks
+	if napfb == nil {
+		return errors.New("fallback disabled")
+	}
+	sessionPolicy := i.policyManager.ForLevel(0)
+
+	// The pre-plaintext connection, needed for the real SNI and ALPN. The worker
+	// stores it on the inbound before any proxy sees it.
+	var iConn net.Conn
+	if inbound := session.InboundFromContext(ctx); inbound != nil {
+		iConn = stat.TryUnwrapStatsConn(inbound.Conn)
+	}
+
+	first := buf.FromBytes(make([]byte, buf.Size))
+	first.Clear()
+	firstLen, err := first.ReadFrom(connection)
+	if err != nil {
+		return errors.New("failed to read fallback request").Base(err)
+	}
+	reader := &buf.BufferedReader{
+		Reader: buf.NewReader(connection),
+		Buffer: buf.MultiBuffer{first},
+	}
+
+	name := ""
+	alpn := ""
+	if tlsConn, ok := iConn.(*tls.Conn); ok {
+		cs := tlsConn.ConnectionState()
+		name = cs.ServerName
+		alpn = cs.NegotiatedProtocol
+	} else if realityConn, ok := iConn.(*reality.Conn); ok {
+		cs := realityConn.ConnectionState()
+		name = cs.ServerName
+		alpn = cs.NegotiatedProtocol
+	}
+	name = strings.ToLower(name)
+	alpn = strings.ToLower(alpn)
+	errors.LogInfo(ctx, "realName = "+name, " realAlpn = "+alpn)
+
+	if len(napfb) > 1 || napfb[""] == nil {
+		if name != "" && napfb[name] == nil {
+			match := ""
+			for n := range napfb {
+				if n != "" && strings.Contains(name, n) && len(n) > len(match) {
+					match = n
+				}
+			}
+			name = match
+		}
+	}
+
+	if napfb[name] == nil {
+		name = ""
+	}
+	apfb := napfb[name]
+	if apfb == nil {
+		return errors.New(`failed to find the default "name" config`)
+	}
+
+	if apfb[alpn] == nil {
+		alpn = ""
+	}
+	pfb := apfb[alpn]
+	if pfb == nil {
+		return errors.New(`failed to find the default "alpn" config`)
+	}
+
+	path := ""
+	if len(pfb) > 1 || pfb[""] == nil {
+		if firstLen >= 18 && first.Byte(4) != '*' { // not h2c
+			firstBytes := first.Bytes()
+			for i := 4; i <= 8; i++ { // 5 -> 9
+				if firstBytes[i] == '/' && firstBytes[i-1] == ' ' {
+					search := len(firstBytes)
+					if search > 64 {
+						search = 64 // up to about 60
+					}
+					for j := i + 1; j < search; j++ {
+						k := firstBytes[j]
+						if k == '\r' || k == '\n' { // avoid logging \r or \n
+							break
+						}
+						if k == '?' || k == ' ' {
+							path = string(firstBytes[i:j])
+							errors.LogInfo(ctx, "realPath = "+path)
+							if pfb[path] == nil {
+								path = ""
+							}
+							break
+						}
+					}
+					break
+				}
+			}
+		}
+	}
+	fb := pfb[path]
+	if fb == nil {
+		return errors.New(`failed to find the default "path" config`)
+	}
+
+	ctx, cancel := context.WithCancel(ctx)
+	timer := signal.CancelAfterInactivity(ctx, cancel, sessionPolicy.Timeouts.ConnectionIdle)
+	ctx = policy.ContextWithBufferPolicy(ctx, sessionPolicy.Buffer)
+
+	var conn net.Conn
+	if err := retry.ExponentialBackoff(5, 100).On(func() error {
+		var dialer net.Dialer
+		conn, err = dialer.DialContext(ctx, fb.Type, fb.Dest)
+		if err != nil {
+			return err
+		}
+		return nil
+	}); err != nil {
+		return errors.New("failed to dial to " + fb.Dest).Base(err)
+	}
+	defer conn.Close()
+
+	serverReader := buf.NewReader(conn)
+	serverWriter := buf.NewWriter(conn)
+
+	postRequest := func() error {
+		defer timer.SetTimeout(sessionPolicy.Timeouts.DownlinkOnly)
+		if fb.Xver != 0 {
+			if err := writeProxyProtocolHeader(serverWriter, connection, fb.Xver); err != nil {
+				return err
+			}
+		}
+		if err := buf.Copy(reader, serverWriter, buf.UpdateActivity(timer)); err != nil {
+			return errors.New("failed to fallback request payload").Base(err)
+		}
+		return nil
+	}
+
+	writer := buf.NewWriter(connection)
+
+	getResponse := func() error {
+		defer timer.SetTimeout(sessionPolicy.Timeouts.UplinkOnly)
+		if err := buf.Copy(serverReader, writer, buf.UpdateActivity(timer)); err != nil {
+			return errors.New("failed to deliver response payload").Base(err)
+		}
+		return nil
+	}
+
+	if err := task.Run(ctx, task.OnSuccess(postRequest, task.Close(serverWriter)), task.OnSuccess(getResponse, task.Close(writer))); err != nil {
+		common.Must(common.Interrupt(serverReader))
+		common.Must(common.Interrupt(serverWriter))
+		return errors.New("fallback ends").Base(err)
+	}
+
+	return nil
+}
+
+func writeProxyProtocolHeader(serverWriter buf.Writer, connection net.Conn, xver uint64) error {
+	ipType := 4
+	remoteAddr, remotePort, err := net.SplitHostPort(connection.RemoteAddr().String())
+	if err != nil {
+		ipType = 0
+	}
+	localAddr, localPort, err := net.SplitHostPort(connection.LocalAddr().String())
+	if err != nil {
+		ipType = 0
+	}
+	if ipType == 4 {
+		for i := 0; i < len(remoteAddr); i++ {
+			if remoteAddr[i] == ':' {
+				ipType = 6
+				break
+			}
+		}
+	}
+	pro := buf.New()
+	defer pro.Release()
+	switch xver {
+	case 1:
+		if ipType == 0 {
+			common.Must2(pro.Write([]byte("PROXY UNKNOWN\r\n")))
+			break
+		}
+		if ipType == 4 {
+			common.Must2(pro.Write([]byte("PROXY TCP4 " + remoteAddr + " " + localAddr + " " + remotePort + " " + localPort + "\r\n")))
+		} else {
+			common.Must2(pro.Write([]byte("PROXY TCP6 " + remoteAddr + " " + localAddr + " " + remotePort + " " + localPort + "\r\n")))
+		}
+	case 2:
+		common.Must2(pro.Write([]byte("\x0D\x0A\x0D\x0A\x00\x0D\x0A\x51\x55\x49\x54\x0A"))) // signature
+		if ipType == 0 {
+			common.Must2(pro.Write([]byte("\x20\x00\x00\x00"))) // v2 + LOCAL + UNSPEC + UNSPEC + 0 bytes
+			break
+		}
+		if ipType == 4 {
+			common.Must2(pro.Write([]byte("\x21\x11\x00\x0C"))) // v2 + PROXY + AF_INET + STREAM + 12 bytes
+			common.Must2(pro.Write(net.ParseIP(remoteAddr).To4()))
+			common.Must2(pro.Write(net.ParseIP(localAddr).To4()))
+		} else {
+			common.Must2(pro.Write([]byte("\x21\x21\x00\x24"))) // v2 + PROXY + AF_INET6 + STREAM + 36 bytes
+			common.Must2(pro.Write(net.ParseIP(remoteAddr).To16()))
+			common.Must2(pro.Write(net.ParseIP(localAddr).To16()))
+		}
+		p1, _ := strconv.ParseUint(remotePort, 10, 16)
+		p2, _ := strconv.ParseUint(localPort, 10, 16)
+		common.Must2(pro.Write([]byte{byte(p1 >> 8), byte(p1), byte(p2 >> 8), byte(p2)}))
+	}
+	if err := serverWriter.WriteMultiBuffer(buf.MultiBuffer{pro}); err != nil {
+		return errors.New("failed to set PROXY protocol v", xver).Base(err)
+	}
+	return nil
+}
diff --git a/proxy/anytls/inbound.go b/proxy/anytls/inbound.go
new file mode 100644
index 00000000..99909230
--- /dev/null
+++ b/proxy/anytls/inbound.go
@@ -0,0 +1,392 @@
+package anytls
+
+import (
+	"bytes"
+	"context"
+	"strconv"
+	"strings"
+	"sync"
+
+	singanytls "github.com/anytls/sing-anytls"
+	"github.com/anytls/sing-anytls/padding"
+	A "github.com/sagernet/sing/common/auth"
+	B "github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/uot"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/log"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/singbridge"
+	"github.com/xtls/xray-core/common/uuid"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/proxy"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+func init() {
+	common.Must(common.RegisterConfig((*ServerConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewServer(ctx, config.(*ServerConfig))
+	}))
+}
+
+var (
+	_ N.TCPConnectionHandlerEx = (*Inbound)(nil)
+	// Without this the handler service's type assertion would fail at runtime and
+	// hot-add would silently no-op.
+	_ proxy.UserManager = (*Inbound)(nil)
+)
+
+// Inbound is an inbound connection handler that speaks the anytls protocol. The
+// wire format is handled by github.com/anytls/sing-anytls; this type is the
+// adapter between it and Xray's dispatcher, in the same shape as
+// proxy/shadowsocks_2022.
+type Inbound struct {
+	access        sync.RWMutex
+	users         []*protocol.MemoryUser
+	service       *singanytls.Service
+	fallbacks     map[string]map[string]map[string]*Fallback // or nil
+	policyManager policy.Manager
+}
+
+func NewServer(ctx context.Context, config *ServerConfig) (*Inbound, error) {
+	users := make([]*protocol.MemoryUser, 0, len(config.Users))
+	for i, user := range config.Users {
+		if user.Email == "" {
+			u := uuid.New()
+			user.Email = "unnamed-user-" + strconv.Itoa(i) + "-" + u.String()
+		}
+		memoryUser, err := user.ToMemoryUser()
+		if err != nil {
+			return nil, errors.New("failed to parse anytls user").Base(err)
+		}
+		account, ok := memoryUser.Account.(*MemoryAccount)
+		if !ok || account.Password == "" {
+			// Hard failure: an empty password must never become a valid credential,
+			// and the only way to get here is a code-level defect, since the JSON
+			// layer already rejects a blank one.
+			return nil, errors.New("anytls user ", memoryUser.Email, " has no password")
+		}
+		// Degrade rather than refuse the config. Xray rejects the WHOLE config when
+		// any one inbound fails to build, so a single bad pair of accounts would take
+		// every other inbound on the box down with it; and this path also carries DB
+		// imports and restores, which no panel-side guard sees. Dropping the later
+		// account is the honest outcome anyway: it could never have worked.
+		if owner, exists := duplicatePasswordOwner(users, account.Password); exists {
+			errors.LogWarning(ctx, "anytls: ignoring user ", memoryUser.Email,
+				": its password is already used by ", owner, ", and the password is the only thing a client sends to identify itself")
+			continue
+		}
+		users = append(users, memoryUser)
+	}
+
+	v := core.MustFromContext(ctx)
+	inbound := &Inbound{
+		users:         users,
+		fallbacks:     buildFallbacks(config.Fallbacks),
+		policyManager: v.GetFeature(policy.ManagerType()).(policy.Manager),
+	}
+
+	scheme := []byte(config.PaddingScheme)
+	if len(bytes.TrimSpace(scheme)) == 0 {
+		// NewService rejects an empty scheme with "incorrect padding scheme format".
+		scheme = padding.DefaultPaddingScheme
+	}
+	serviceConfig := singanytls.ServiceConfig{
+		PaddingScheme: scheme,
+		Users:         toServiceUsers(users),
+		Handler:       inbound,
+		Logger:        singbridge.NewLogger(errors.New),
+	}
+	if inbound.fallbacks != nil {
+		serviceConfig.FallbackHandler = &fallbackHandler{inbound: inbound}
+	}
+	service, err := singanytls.NewService(serviceConfig)
+	if err != nil {
+		return nil, errors.New("failed to create anytls service").Base(err)
+	}
+	inbound.service = service
+
+	return inbound, nil
+}
+
+// duplicatePasswordOwner reports the email of the user already holding password.
+//
+// A password is the only thing an anytls client sends to identify itself, so two
+// accounts sharing one are indistinguishable on the wire and all of the loser's
+// traffic would be booked against the winner.
+func duplicatePasswordOwner(users []*protocol.MemoryUser, password string) (string, bool) {
+	for _, u := range users {
+		if account, ok := u.Account.(*MemoryAccount); ok && account.Password == password {
+			return u.Email, true
+		}
+	}
+	return "", false
+}
+
+func toServiceUsers(users []*protocol.MemoryUser) []singanytls.User {
+	serviceUsers := make([]singanytls.User, 0, len(users))
+	for _, u := range users {
+		account, ok := u.Account.(*MemoryAccount)
+		if !ok {
+			continue
+		}
+		// Name is what comes back out of auth.UserFromContext, so it has to be the
+		// account email: that is the key everything downstream is booked against.
+		serviceUsers = append(serviceUsers, singanytls.User{Name: u.Email, Password: account.Password})
+	}
+	return serviceUsers
+}
+
+// syncUsers pushes the whole user list into the service. Must be called with
+// access held.
+func (i *Inbound) syncUsers() {
+	i.service.UpdateUsers(toServiceUsers(i.users))
+}
+
+// AddUser implements proxy.UserManager.AddUser().
+func (i *Inbound) AddUser(ctx context.Context, u *protocol.MemoryUser) error {
+	account, ok := u.Account.(*MemoryAccount)
+	if !ok || account.Password == "" {
+		return errors.New("anytls user ", u.Email, " has no password")
+	}
+
+	i.access.Lock()
+	defer i.access.Unlock()
+
+	if u.Email != "" {
+		for _, existing := range i.users {
+			if strings.EqualFold(existing.Email, u.Email) {
+				return errors.New("User ", u.Email, " already exists.")
+			}
+		}
+	}
+	// Hard error here, unlike the config path: this is a single operator action,
+	// nothing else goes down with it, and the caller can report it.
+	if owner, exists := duplicatePasswordOwner(i.users, account.Password); exists {
+		return errors.New("anytls user ", u.Email, " shares a password with ", owner)
+	}
+
+	i.users = append(i.users, u)
+	i.syncUsers()
+	return nil
+}
+
+// RemoveUser implements proxy.UserManager.RemoveUser().
+func (i *Inbound) RemoveUser(ctx context.Context, email string) error {
+	if email == "" {
+		return errors.New("Email must not be empty.")
+	}
+
+	i.access.Lock()
+	defer i.access.Unlock()
+
+	idx := -1
+	for index, u := range i.users {
+		if strings.EqualFold(u.Email, email) {
+			idx = index
+			break
+		}
+	}
+	if idx == -1 {
+		return errors.New("User ", email, " not found.")
+	}
+
+	ulen := len(i.users)
+	i.users[idx] = i.users[ulen-1]
+	i.users[ulen-1] = nil
+	i.users = i.users[:ulen-1]
+
+	i.syncUsers()
+	return nil
+}
+
+// GetUser implements proxy.UserManager.GetUser().
+func (i *Inbound) GetUser(ctx context.Context, email string) *protocol.MemoryUser {
+	if email == "" {
+		return nil
+	}
+
+	i.access.RLock()
+	defer i.access.RUnlock()
+
+	for _, u := range i.users {
+		if strings.EqualFold(u.Email, email) {
+			return u
+		}
+	}
+	return nil
+}
+
+// GetUsers implements proxy.UserManager.GetUsers().
+func (i *Inbound) GetUsers(ctx context.Context) []*protocol.MemoryUser {
+	i.access.RLock()
+	defer i.access.RUnlock()
+
+	dst := make([]*protocol.MemoryUser, len(i.users))
+	copy(dst, i.users)
+	return dst
+}
+
+// GetUsersCount implements proxy.UserManager.GetUsersCount().
+func (i *Inbound) GetUsersCount(context.Context) int64 {
+	i.access.RLock()
+	defer i.access.RUnlock()
+
+	return int64(len(i.users))
+}
+
+// Network implements proxy.Inbound.Network().
+func (i *Inbound) Network() []net.Network {
+	return []net.Network{net.Network_TCP, net.Network_UNIX}
+}
+
+// Process implements proxy.Inbound.Process().
+func (i *Inbound) Process(ctx context.Context, network net.Network, connection stat.Connection, dispatcher routing.Dispatcher) error {
+	inbound := session.InboundFromContext(ctx)
+	inbound.Name = "anytls"
+	inbound.CanSpliceCopy = 3
+
+	var source M.Socksaddr
+	if inbound.Source.IsValid() {
+		source = M.ParseSocksaddr(inbound.Source.NetAddr())
+	}
+
+	ctx = session.ContextWithDispatcher(ctx, dispatcher)
+
+	// TLS/REALITY has already been terminated by Xray's transport layer, so the
+	// connection handed over here is the plaintext NewConnection expects. It runs
+	// the session inline and returns only once the session is over, which is
+	// exactly Process' contract, so onClose has nothing left to do.
+	return singbridge.ReturnError(i.service.NewConnection(ctx, connection, source, nil))
+}
+
+// NewConnectionEx implements N.TCPConnectionHandlerEx: one call per stream
+// multiplexed over the anytls session, each on its own goroutine.
+func (i *Inbound) NewConnectionEx(ctx context.Context, conn net.Conn, source M.Socksaddr, destination M.Socksaddr, onClose N.CloseHandlerFunc) {
+	err := i.handleStream(ctx, conn, source, destination)
+	// The session does not close streams for us, and nothing else will: unlike a
+	// plain inbound, Process outlives every individual stream.
+	conn.Close()
+	if err != nil && !E.IsClosedOrCanceled(err) {
+		errors.LogInfo(ctx, "anytls: ", err.Error())
+	}
+	if onClose != nil {
+		onClose(err)
+	}
+}
+
+func (i *Inbound) handleStream(ctx context.Context, conn net.Conn, source M.Socksaddr, destination M.Socksaddr) error {
+	userName, _ := A.UserFromContext[string](ctx)
+	user := i.GetUser(ctx, userName)
+	if user == nil {
+		return errors.New("unknown user ", userName)
+	}
+
+	// Every stream of one anytls session shares this context, so each gets its own
+	// copy of the inbound metadata: the dispatcher reads User off it and the speed
+	// limiter writes CanSpliceCopy back, which would race across streams otherwise.
+	inbound := *session.InboundFromContext(ctx)
+	inbound.Name = "anytls"
+	inbound.CanSpliceCopy = 3
+	inbound.User = user
+	ctx = session.ContextWithInbound(ctx, &inbound)
+
+	dispatcher := session.DispatcherFromContext(ctx)
+	if dispatcher == nil {
+		return errors.New("no dispatcher in context")
+	}
+
+	// anytls has no UDP of its own: clients tunnel it as UDP-over-TCP to a magic
+	// address. Without this the stream would be dispatched as a TCP connection to
+	// a domain that does not exist and UDP would silently never work.
+	if destination.IsFqdn() {
+		switch destination.Fqdn {
+		case uot.MagicAddress:
+			request, err := uot.ReadRequest(conn)
+			if err != nil {
+				return errors.New("failed to read UDP-over-TCP request").Base(err)
+			}
+			return i.handlePacketStream(ctx, uot.NewConn(conn, *request), source, request.Destination, user, dispatcher)
+		case uot.LegacyMagicAddress:
+			// v1 has no request header at all; the destination arrives with the
+			// first packet.
+			return i.handlePacketStream(ctx, uot.NewConn(conn, uot.Request{}), source, M.Socksaddr{}, user, dispatcher)
+		}
+	}
+
+	dest := singbridge.ToDestination(destination, net.Network_TCP)
+	if !dest.IsValid() {
+		return errors.New("invalid destination ", destination.String())
+	}
+
+	ctx = log.ContextWithAccessMessage(ctx, &log.AccessMessage{
+		From:   source,
+		To:     dest,
+		Status: log.AccessAccepted,
+		Email:  user.Email,
+	})
+	errors.LogInfo(ctx, "tunnelling request to tcp:", dest.NetAddr())
+
+	link, err := dispatcher.Dispatch(ctx, dest)
+	if err != nil {
+		return err
+	}
+	return singbridge.CopyConn(ctx, conn, link, conn)
+}
+
+func (i *Inbound) handlePacketStream(ctx context.Context, conn *uot.Conn, source M.Socksaddr, destination M.Socksaddr, user *protocol.MemoryUser, dispatcher routing.Dispatcher) error {
+	var first *B.Buffer
+	if !destination.IsValid() {
+		first = B.NewPacket()
+		addr, err := conn.ReadPacket(first)
+		if err != nil {
+			first.Release()
+			return errors.New("failed to read first UDP-over-TCP packet").Base(err)
+		}
+		destination = addr
+	}
+	defer func() {
+		if first != nil {
+			first.Release()
+		}
+	}()
+
+	dest := singbridge.ToDestination(destination, net.Network_UDP)
+	if !dest.IsValid() {
+		return errors.New("invalid UDP destination ", destination.String())
+	}
+
+	ctx = log.ContextWithAccessMessage(ctx, &log.AccessMessage{
+		From:   source,
+		To:     dest,
+		Status: log.AccessAccepted,
+		Email:  user.Email,
+	})
+	errors.LogInfo(ctx, "tunnelling request to udp:", dest.NetAddr())
+
+	link, err := dispatcher.Dispatch(ctx, dest)
+	if err != nil {
+		return err
+	}
+	outConn := &singbridge.PacketConnWrapper{
+		Reader: link.Reader,
+		Writer: link.Writer,
+		Conn:   conn,
+		Dest:   dest,
+	}
+	if first != nil {
+		if err := outConn.WritePacket(first, destination); err != nil {
+			return err
+		}
+	}
+	return singbridge.ReturnError(bufio.CopyPacketConn(ctx, conn, outConn))
+}
diff --git a/proxy/anytls/outbound.go b/proxy/anytls/outbound.go
new file mode 100644
index 00000000..bf60ff31
--- /dev/null
+++ b/proxy/anytls/outbound.go
@@ -0,0 +1,177 @@
+package anytls
+
+import (
+	"context"
+	gonet "net"
+	"sync"
+	"time"
+
+	singanytls "github.com/anytls/sing-anytls"
+	"github.com/anytls/sing-anytls/util"
+	"github.com/sagernet/sing/common/bufio"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/uot"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/singbridge"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func init() {
+	common.Must(common.RegisterConfig((*ClientConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewClient(ctx, config.(*ClientConfig))
+	}))
+}
+
+// Outbound is an outbound connection handler that speaks the anytls protocol.
+type Outbound struct {
+	ctx    context.Context
+	server net.Destination
+	config *ClientConfig
+
+	access sync.Mutex
+	client *singanytls.Client
+	dialer internet.Dialer
+}
+
+func NewClient(ctx context.Context, config *ClientConfig) (*Outbound, error) {
+	if config.Address == nil {
+		return nil, errors.New("anytls server address is not set")
+	}
+	if config.Port == 0 {
+		return nil, errors.New("invalid anytls port")
+	}
+	if config.Password == "" {
+		return nil, errors.New("anytls password is not specified")
+	}
+	return &Outbound{
+		ctx: ctx,
+		server: net.Destination{
+			Address: config.Address.AsAddress(),
+			Port:    net.Port(config.Port),
+			Network: net.Network_TCP,
+		},
+		config: config,
+	}, nil
+}
+
+// getClient lazily builds the session client around the dialer Xray hands to
+// Process. The dialer is a property of the outbound handler rather than of a
+// single request, but it is only available from Process, and it is replaced
+// whenever the handler is rebuilt, so the client is rebuilt with it.
+func (o *Outbound) getClient(dialer internet.Dialer) (*singanytls.Client, error) {
+	o.access.Lock()
+	defer o.access.Unlock()
+
+	if o.client != nil && o.dialer == dialer {
+		return o.client, nil
+	}
+	if o.client != nil {
+		o.client.Close()
+		o.client = nil
+	}
+
+	client, err := singanytls.NewClient(core.ToBackgroundDetachedContext(o.ctx), singanytls.ClientConfig{
+		Password:                 o.config.Password,
+		IdleSessionCheckInterval: time.Duration(o.config.IdleSessionCheckInterval) * time.Second,
+		IdleSessionTimeout:       time.Duration(o.config.IdleSessionTimeout) * time.Second,
+		MinIdleSession:           int(o.config.MinIdleSession),
+		DisableReuse:             o.config.DisableReuse,
+		DialOut:                  o.dialOut(dialer),
+		Logger:                   singbridge.NewLogger(errors.New),
+	})
+	if err != nil {
+		return nil, errors.New("failed to create anytls client").Base(err)
+	}
+	o.client = client
+	o.dialer = dialer
+	return client, nil
+}
+
+func (o *Outbound) dialOut(dialer internet.Dialer) util.DialOutFunc {
+	return func(context.Context) (gonet.Conn, error) {
+		// Deliberately not the caller's context. A session outlives the request
+		// that happened to open it and is then reused by others, so tying its
+		// underlying connection to that first request would tear the session down
+		// under everyone else (and, with proxySettings, kill the dialer-proxy
+		// goroutine outright).
+		ctx := core.ToBackgroundDetachedContext(o.ctx)
+		ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{
+			Target:        o.server,
+			Name:          "anytls",
+			CanSpliceCopy: 3,
+		}})
+		conn, err := dialer.Dial(ctx, o.server)
+		if err != nil {
+			return nil, errors.New("failed to connect to anytls server").Base(err)
+		}
+		return conn, nil
+	}
+}
+
+// Process implements proxy.Outbound.Process().
+func (o *Outbound) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	outbounds := session.OutboundsFromContext(ctx)
+	ob := outbounds[len(outbounds)-1]
+	if !ob.Target.IsValid() {
+		return errors.New("target not specified")
+	}
+	ob.Name = "anytls"
+	ob.CanSpliceCopy = 3
+	destination := ob.Target
+
+	client, err := o.getClient(dialer)
+	if err != nil {
+		return err
+	}
+
+	errors.LogInfo(ctx, "tunneling request to ", destination, " via ", o.server.NetAddr())
+
+	var inboundConn net.Conn
+	if inbound := session.InboundFromContext(ctx); inbound != nil {
+		inboundConn = inbound.Conn
+	}
+
+	if session.TimeoutOnlyFromContext(ctx) {
+		ctx = context.WithoutCancel(ctx)
+	}
+
+	if destination.Network == net.Network_UDP {
+		// anytls carries no UDP, so it goes out as UDP-over-TCP the same way the
+		// inbound expects to receive it.
+		stream, err := client.CreateProxy(ctx, uot.RequestDestination(uot.Version))
+		if err != nil {
+			return errors.New("failed to create anytls stream").Base(err)
+		}
+		uConn := uot.NewLazyConn(stream, uot.Request{
+			IsConnect:   true,
+			Destination: singbridge.ToSocksaddr(destination),
+		})
+
+		var packetConn N.PacketConn
+		if pc, isPacketConn := inboundConn.(N.PacketConn); isPacketConn {
+			packetConn = pc
+		} else if nc, isNetPacket := inboundConn.(net.PacketConn); isNetPacket {
+			packetConn = bufio.NewPacketConn(nc)
+		} else {
+			packetConn = &singbridge.PacketConnWrapper{
+				Reader: link.Reader,
+				Writer: link.Writer,
+				Conn:   inboundConn,
+				Dest:   destination,
+			}
+		}
+		return singbridge.ReturnError(bufio.CopyPacketConn(ctx, packetConn, uConn))
+	}
+
+	stream, err := client.CreateProxy(ctx, singbridge.ToSocksaddr(destination))
+	if err != nil {
+		return errors.New("failed to create anytls stream").Base(err)
+	}
+	return singbridge.CopyConn(ctx, inboundConn, link, stream)
+}
diff --git a/proxy/naive/client.go b/proxy/naive/client.go
new file mode 100644
index 00000000..618f788c
--- /dev/null
+++ b/proxy/naive/client.go
@@ -0,0 +1,232 @@
+package naive
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"net/http"
+	"net/url"
+
+	"golang.org/x/net/http2"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/retry"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/common/signal"
+	"github.com/xtls/xray-core/common/task"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/proxy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	naivetransport "github.com/xtls/xray-core/transport/internet/naive"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+var _ proxy.Outbound = (*Client)(nil)
+
+// Client is the naive outbound. It speaks CONNECT over HTTP/2 (through whatever
+// TLS the stream settings provide, so Xray's uTLS Chrome fingerprint applies for
+// free) or over HTTP/3 (through transport/internet/naive).
+type Client struct {
+	server        *protocol.ServerSpec
+	policyManager policy.Manager
+	useH3         bool
+}
+
+// NewClient creates a new naive outbound handler.
+func NewClient(ctx context.Context, config *ClientConfig) (*Client, error) {
+	if config.Server == nil {
+		return nil, errors.New("no target server found")
+	}
+	server, err := protocol.NewServerSpecFromPB(config.Server)
+	if err != nil {
+		return nil, errors.New("failed to get server spec").Base(err)
+	}
+	if server.User == nil {
+		return nil, errors.New("naive: server has no user")
+	}
+
+	tcp, udp := naivetransport.ParseNetwork(config.Network)
+	// A single outbound dials one wire; "udp" (h3) only when it is asked for
+	// explicitly, since h2 is what a "https://" naive URI means.
+	useH3 := udp && !tcp
+
+	v := core.MustFromContext(ctx)
+	return &Client{
+		server:        server,
+		policyManager: v.GetFeature(policy.ManagerType()).(policy.Manager),
+		useH3:         useH3,
+	}, nil
+}
+
+func (c *Client) requestHeader(account *MemoryAccount, username, authority string) http.Header {
+	header := http.Header{}
+	header.Set(headerProxyAuthorization, "Basic "+base64.StdEncoding.EncodeToString([]byte(username+":"+account.Password)))
+	header.Set(headerPadding, RequestPaddingHeader())
+	header.Set(headerPaddingTypeRequest, "1, 0")
+	// Cronet sends the authority twice; matching it keeps our request shape
+	// indistinguishable from the reference client.
+	header.Set(headerConnectAuthority, authority)
+	return header
+}
+
+// Process implements proxy.Outbound.
+func (c *Client) Process(ctx context.Context, link *transport.Link, dialer internet.Dialer) error {
+	outbounds := session.OutboundsFromContext(ctx)
+	ob := outbounds[len(outbounds)-1]
+	if !ob.Target.IsValid() {
+		return errors.New("target not specified")
+	}
+	ob.Name = "naive"
+	ob.CanSpliceCopy = 3
+	destination := ob.Target
+
+	if destination.Network == net.Network_UDP {
+		return errors.New("naive: UDP is not supported, naive is an HTTP CONNECT proxy")
+	}
+
+	user := c.server.User
+	account, ok := user.Account.(*MemoryAccount)
+	if !ok {
+		return errors.New("naive: user account is not valid")
+	}
+	authority := destination.NetAddr()
+	// The remote server decides what the Basic username means, so send its
+	// username when the config carries one and the email otherwise. Our own
+	// inbound accepts both spellings.
+	header := c.requestHeader(account, BasicUsername(user), authority)
+
+	var (
+		conn         stat.Connection
+		reader       io.Reader
+		writer       io.Writer
+		halfClose    func()
+		closeFuncs   []func()
+		responseHead http.Header
+	)
+	defer func() {
+		for i := len(closeFuncs) - 1; i >= 0; i-- {
+			closeFuncs[i]()
+		}
+	}()
+
+	if c.useH3 {
+		request := &naivetransport.ConnectRequest{Authority: authority, Header: header}
+		dialCtx := naivetransport.ContextWithConnectRequest(ctx, request)
+		err := retry.ExponentialBackoff(5, 100).On(func() error {
+			rawConn, err := dialer.Dial(dialCtx, c.server.Destination)
+			if err != nil {
+				return err
+			}
+			conn = rawConn
+			return nil
+		})
+		if err != nil {
+			return errors.New("naive: failed to find an available destination").Base(err)
+		}
+		closeFuncs = append(closeFuncs, func() { conn.Close() })
+		if request.StatusCode != http.StatusOK {
+			return errors.New("naive: server rejected CONNECT with status ", request.StatusCode)
+		}
+		responseHead = request.Response
+		reader = conn
+		writer = conn
+		if cw, ok := conn.(interface{ CloseWrite() error }); ok {
+			halfClose = func() { cw.CloseWrite() }
+		}
+	} else {
+		err := retry.ExponentialBackoff(5, 100).On(func() error {
+			rawConn, err := dialer.Dial(ctx, c.server.Destination)
+			if err != nil {
+				return err
+			}
+			conn = rawConn
+			return nil
+		})
+		if err != nil {
+			return errors.New("naive: failed to find an available destination").Base(err)
+		}
+		closeFuncs = append(closeFuncs, func() { conn.Close() })
+
+		if tlsConn, ok := conn.(tls.Interface); ok {
+			if alpn := tlsConn.NegotiatedProtocol(); alpn != "" && alpn != "h2" {
+				return errors.New(`naive: server negotiated ALPN "`, alpn, `", set "alpn": ["h2"] in tlsSettings`)
+			}
+		}
+
+		requestBody, requestWriter := io.Pipe()
+		closeFuncs = append(closeFuncs, func() { requestWriter.Close() })
+
+		request := &http.Request{
+			Method: http.MethodConnect,
+			URL:    &url.URL{Scheme: "https", Host: authority},
+			Host:   authority,
+			Header: header,
+			Body:   requestBody,
+		}
+		request = request.WithContext(ctx)
+
+		clientConn, err := (&http2.Transport{}).NewClientConn(conn)
+		if err != nil {
+			return errors.New("naive: failed to start HTTP/2").Base(err)
+		}
+		response, err := clientConn.RoundTrip(request)
+		if err != nil {
+			return errors.New("naive: CONNECT failed").Base(err)
+		}
+		closeFuncs = append(closeFuncs, func() { response.Body.Close() })
+		if response.StatusCode != http.StatusOK {
+			return errors.New("naive: server rejected CONNECT with status ", response.Status)
+		}
+		responseHead = response.Header
+		reader = response.Body
+		writer = requestWriter
+		halfClose = func() { requestWriter.Close() }
+	}
+
+	errors.LogInfo(ctx, "naive: tunneling request to ", destination, " via ", c.server.Destination.NetAddr())
+
+	paddingType, err := NegotiateClientPadding(responseHead)
+	if err != nil {
+		return err
+	}
+	if paddingType == PaddingTypeVariant1 {
+		reader = newPaddingReader(reader)
+		writer = newPaddingWriter(writer)
+	}
+
+	sessionPolicy := c.policyManager.ForLevel(user.Level)
+	ctx, cancel := context.WithCancel(ctx)
+	timer := signal.CancelAfterInactivity(ctx, cancel, sessionPolicy.Timeouts.ConnectionIdle)
+
+	requestDone := func() error {
+		defer timer.SetTimeout(sessionPolicy.Timeouts.DownlinkOnly)
+		err := buf.Copy(link.Reader, buf.NewWriter(writer), buf.UpdateActivity(timer))
+		// Half-close so the far end sees EOF while the downlink keeps running.
+		if halfClose != nil {
+			halfClose()
+		}
+		return err
+	}
+	responseDone := func() error {
+		defer timer.SetTimeout(sessionPolicy.Timeouts.UplinkOnly)
+		return buf.Copy(buf.NewReader(reader), link.Writer, buf.UpdateActivity(timer))
+	}
+
+	if err := task.Run(ctx, requestDone, responseDone); err != nil {
+		return errors.New("naive: connection ends").Base(err)
+	}
+	return nil
+}
+
+func init() {
+	common.Must(common.RegisterConfig((*ClientConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewClient(ctx, config.(*ClientConfig))
+	}))
+}
diff --git a/proxy/naive/config.go b/proxy/naive/config.go
new file mode 100644
index 00000000..161947c9
--- /dev/null
+++ b/proxy/naive/config.go
@@ -0,0 +1,227 @@
+package naive
+
+import (
+	"crypto/subtle"
+	gotls "crypto/tls"
+	"net/http"
+	"net/http/httputil"
+	"net/url"
+	"strings"
+	"sync"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/protocol"
+	"google.golang.org/protobuf/proto"
+)
+
+// AsAccount implements protocol.AsAccount.
+func (a *Account) AsAccount() (protocol.Account, error) {
+	return &MemoryAccount{Password: a.Password, Username: a.Username}, nil
+}
+
+// MemoryAccount is the in-memory form of a naive client credential.
+type MemoryAccount struct {
+	Password string
+	// Username is the Basic-auth username. Empty means the account email is
+	// used instead, which is how every client saved before this field existed
+	// still authenticates.
+	Username string
+}
+
+// Equals implements protocol.Account.Equals.
+func (a *MemoryAccount) Equals(another protocol.Account) bool {
+	if account, ok := another.(*MemoryAccount); ok {
+		return a.Password == account.Password && a.Username == account.Username
+	}
+	return false
+}
+
