diff --git a/transport/internet/naive/config_test.go b/transport/internet/naive/config_test.go
new file mode 100644
index 00000000..be007fe0
--- /dev/null
+++ b/transport/internet/naive/config_test.go
@@ -0,0 +1,46 @@
+package naive
+
+import "testing"
+
+// TestParseNetwork pins the spelling shared by settings.network, naiveSettings
+// and the outbound. The empty and unrecognised cases are the ones that matter:
+// they mean BOTH, not tcp, and a hand-edited config is the likeliest source of
+// them.
+func TestParseNetwork(t *testing.T) {
+	cases := []struct {
+		in       string
+		tcp, udp bool
+	}{
+		{"tcp", true, false},
+		{"udp", false, true},
+		{"tcp,udp", true, true},
+		{"udp,tcp", true, true},
+		{" TCP , UDP ", true, true},
+		{"h2", true, false},
+		{"h3", false, true},
+		{"quic", false, true},
+		{"", true, true},
+		{"nonsense", true, true},
+		{",", true, true},
+	}
+	for _, c := range cases {
+		t.Run(c.in, func(t *testing.T) {
+			tcp, udp := ParseNetwork(c.in)
+			if tcp != c.tcp || udp != c.udp {
+				t.Fatalf("ParseNetwork(%q) = (%v, %v), want (%v, %v)", c.in, tcp, udp, c.tcp, c.udp)
+			}
+		})
+	}
+}
+
+// TestConfigMode covers the nil receiver, which is what a stream config with no
+// naiveSettings block produces.
+func TestConfigMode(t *testing.T) {
+	var nilConfig *Config
+	if mode := nilConfig.mode(); !mode.tcp || !mode.udp {
+		t.Fatalf("a nil config must listen on both wires, got %+v", mode)
+	}
+	if mode := (&Config{Network: "udp"}).mode(); mode.tcp || !mode.udp {
+		t.Fatalf(`Network "udp" must be h3 only, got %+v`, mode)
+	}
+}
diff --git a/transport/internet/naive/conn.go b/transport/internet/naive/conn.go
new file mode 100644
index 00000000..cf8bff71
--- /dev/null
+++ b/transport/internet/naive/conn.go
@@ -0,0 +1,129 @@
+package naive
+
+import (
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// requestConn adapts a single in-flight HTTP/3 request to net.Conn so that it
+// can be pushed through internet.ConnHandler and end up in the naive inbound's
+// Process(), which is where every naive-protocol decision lives.
+//
+// The inbound recognises it structurally (HTTPRequest/HTTPResponseWriter) and
+// drives the exchange from the http.ResponseWriter, so Read/Write here are only
+// a fallback for generic plumbing.
+type requestConn struct {
+	w      http.ResponseWriter
+	r      *http.Request
+	flush  http.Flusher
+	local  net.Addr
+	remote net.Addr
+
+	done      chan struct{}
+	closeOnce sync.Once
+
+	writeMu sync.Mutex
+}
+
+func newRequestConn(w http.ResponseWriter, r *http.Request, local net.Addr) *requestConn {
+	c := &requestConn{
+		w:      w,
+		r:      r,
+		local:  local,
+		remote: parseAddr(r.RemoteAddr),
+		done:   make(chan struct{}),
+	}
+	c.flush, _ = w.(http.Flusher)
+	return c
+}
+
+// parseAddr turns quic-go's "ip:port" RemoteAddr string into a *net.TCPAddr.
+// TCP (not UDP) is deliberate: the inbound is driven by the stream worker, so
+// session.Inbound.Source must read as a TCP destination for the routing,
+// statistics and IP-limiter code paths.
+func parseAddr(s string) net.Addr {
+	host, port, err := net.SplitHostPort(s)
+	if err != nil {
+		return &net.TCPAddr{}
+	}
+	p, _ := strconv.Atoi(port)
+	return &net.TCPAddr{IP: net.ParseIP(host), Port: p}
+}
+
+// HTTPRequest exposes the request that opened this stream.
+func (c *requestConn) HTTPRequest() *http.Request { return c.r }
+
+// HTTPResponseWriter exposes the writer for this stream.
+func (c *requestConn) HTTPResponseWriter() http.ResponseWriter { return c.w }
+
+func (c *requestConn) Read(b []byte) (int, error) {
+	if c.r.Body == nil {
+		return 0, io.EOF
+	}
+	return c.r.Body.Read(b)
+}
+
+func (c *requestConn) Write(b []byte) (int, error) {
+	c.writeMu.Lock()
+	defer c.writeMu.Unlock()
+	select {
+	case <-c.done:
+		return 0, io.ErrClosedPipe
+	default:
+	}
+	n, err := c.w.Write(b)
+	if err == nil && c.flush != nil {
+		c.flush.Flush()
+	}
+	return n, err
+}
+
+// Close releases the handler goroutine that is parked on Wait, which is what
+// finally completes the HTTP/3 response.
+func (c *requestConn) Close() error {
+	c.closeOnce.Do(func() { close(c.done) })
+	return nil
+}
+
+// Wait blocks until Close is called.
+func (c *requestConn) Wait() <-chan struct{} { return c.done }
+
+func (c *requestConn) LocalAddr() net.Addr  { return c.local }
+func (c *requestConn) RemoteAddr() net.Addr { return c.remote }
+
+func (c *requestConn) SetDeadline(time.Time) error      { return nil }
+func (c *requestConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *requestConn) SetWriteDeadline(time.Time) error { return nil }
+
+// streamConn is the client-side counterpart: an HTTP/3 request stream that has
+// already exchanged CONNECT headers, presented as a net.Conn.
+type streamConn struct {
+	stream interface {
+		io.Reader
+		io.Writer
+		io.Closer
+		SetDeadline(time.Time) error
+		SetReadDeadline(time.Time) error
+		SetWriteDeadline(time.Time) error
+	}
+	local  net.Addr
+	remote net.Addr
+}
+
+func (c *streamConn) Read(b []byte) (int, error)  { return c.stream.Read(b) }
+func (c *streamConn) Write(b []byte) (int, error) { return c.stream.Write(b) }
+func (c *streamConn) Close() error                { return c.stream.Close() }
+
+// CloseWrite half-closes the stream. QUIC's Close only ends the send side, so
+// this is exactly what the naive outbound needs when its uplink runs dry.
+func (c *streamConn) CloseWrite() error { return c.stream.Close() }
+
+func (c *streamConn) LocalAddr() net.Addr                { return c.local }
+func (c *streamConn) RemoteAddr() net.Addr               { return c.remote }
+func (c *streamConn) SetDeadline(t time.Time) error      { return c.stream.SetDeadline(t) }
+func (c *streamConn) SetReadDeadline(t time.Time) error  { return c.stream.SetReadDeadline(t) }
+func (c *streamConn) SetWriteDeadline(t time.Time) error { return c.stream.SetWriteDeadline(t) }
diff --git a/transport/internet/naive/dialer.go b/transport/internet/naive/dialer.go
new file mode 100644
index 00000000..7d289612
--- /dev/null
+++ b/transport/internet/naive/dialer.go
@@ -0,0 +1,219 @@
+package naive
+
+import (
+	"context"
+	"net/http"
+	"net/url"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/apernet/quic-go"
+	"github.com/apernet/quic-go/http3"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion/bbr"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+// ConnectRequest carries one naive CONNECT exchange across the proxy/transport
+// boundary. The proxy owns the naive protocol (auth, padding, target), the
+// transport owns the QUIC and HTTP/3 machinery, and this is the only thing they
+// need to agree on.
+type ConnectRequest struct {
+	Authority string
+	Header    http.Header
+
+	// Filled in by the dialer once the response headers arrive.
+	StatusCode int
+	Response   http.Header
+}
+
+type connectRequestKey struct{}
+
+// ContextWithConnectRequest attaches a CONNECT exchange for the dialer to run.
+func ContextWithConnectRequest(ctx context.Context, r *ConnectRequest) context.Context {
+	return context.WithValue(ctx, connectRequestKey{}, r)
+}
+
+// ConnectRequestFromContext returns the CONNECT exchange, if any.
+func ConnectRequestFromContext(ctx context.Context) *ConnectRequest {
+	r, _ := ctx.Value(connectRequestKey{}).(*ConnectRequest)
+	return r
+}
+
+type h3Session struct {
+	quicConn *quic.Conn
+	client   *http3.ClientConn
+}
+
+var (
+	h3Mutex    sync.Mutex
+	h3Sessions = make(map[string]*h3Session)
+)
+
+func sessionKey(dest net.Destination, serverName string) string {
+	return dest.NetAddr() + "|" + serverName
+}
+
+func dialH3(ctx context.Context, dest net.Destination, streamSettings *internet.MemoryStreamConfig) (*h3Session, error) {
+	tlsSettings := tls.ConfigFromStreamSettings(streamSettings)
+	if tlsSettings == nil {
+		return nil, errors.New("naive over HTTP/3 requires TLS")
+	}
+	tlsConfig := tlsSettings.GetTLSConfig(tls.WithDestination(dest))
+	if !slices.Contains(tlsConfig.NextProtos, http3.NextProtoH3) {
+		tlsConfig.NextProtos = []string{http3.NextProtoH3}
+	}
+
+	key := sessionKey(dest, tlsConfig.ServerName)
+
+	h3Mutex.Lock()
+	defer h3Mutex.Unlock()
+
+	if session := h3Sessions[key]; session != nil {
+		select {
+		case <-session.client.Context().Done():
+			delete(h3Sessions, key)
+		default:
+			return session, nil
+		}
+	}
+
+	// The proxy hands us a TCP destination (that is what a server address is),
+	// but h3 rides QUIC, so the socket has to be a UDP one.
+	udpDest := dest
+	udpDest.Network = net.Network_UDP
+	var conn net.Conn
+	var err error
+	if streamSettings.FinalMask != nil {
+		conn, err = streamSettings.FinalMask.DialUDP(ctx, udpDest)
+	} else {
+		conn, err = internet.DialSystem(ctx, udpDest, streamSettings.SocketSettings)
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	var packetConn net.PacketConn
+	var udpAddr *net.UDPAddr
+	switch c := conn.(type) {
+	case *net.PacketConnWrapper:
+		packetConn = c.PacketConn
+		udpAddr, err = net.ResolveUDPAddr("udp", c.Dest.String())
+	case *net.UDPConn:
+		packetConn = c
+		udpAddr, err = net.ResolveUDPAddr("udp", c.RemoteAddr().String())
+	default:
+		packetConn = &internet.FakePacketConn{Conn: c}
+		udpAddr, err = net.ResolveUDPAddr("udp", c.RemoteAddr().String())
+	}
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+
+	quicParams := streamSettings.QuicParams
+	if quicParams == nil {
+		quicParams = &internet.QuicParams{
+			BbrProfile: string(bbr.ProfileStandard),
+		}
+	}
+	quicConfig := &quic.Config{
+		InitialStreamReceiveWindow:     quicParams.InitStreamReceiveWindow,
+		MaxStreamReceiveWindow:         quicParams.MaxStreamReceiveWindow,
+		InitialConnectionReceiveWindow: quicParams.InitConnReceiveWindow,
+		MaxConnectionReceiveWindow:     quicParams.MaxConnReceiveWindow,
+		MaxIdleTimeout:                 time.Duration(quicParams.MaxIdleTimeout) * time.Second,
+		DisablePathMTUDiscovery:        quicParams.DisablePathMtuDiscovery,
+	}
+	if quicConfig.MaxIdleTimeout == 0 {
+		quicConfig.MaxIdleTimeout = 30 * time.Second
+	}
+
+	quicConn, err := quic.DialEarly(ctx, packetConn, udpAddr, tlsConfig, quicConfig)
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	switch quicParams.Congestion {
+	case "force-brutal":
+		congestion.UseBrutal(quicConn, quicParams.BrutalUp, quicParams.BrutalDisableLossCompensation)
+	case "reno":
+	default:
+		congestion.UseBBR(quicConn, bbr.Profile(quicParams.BbrProfile))
+	}
+
+	session := &h3Session{
+		quicConn: quicConn,
+		client:   (&http3.Transport{}).NewClientConn(quicConn),
+	}
+	h3Sessions[key] = session
+	return session, nil
+}
+
+// Dial implements internet.Dialer for the naive transport. It only serves the
+// HTTP/3 wire; the HTTP/2 wire needs no transport of its own because it runs
+// over the standard TLS stream, which is also how it inherits uTLS.
+func Dial(ctx context.Context, dest net.Destination, streamSettings *internet.MemoryStreamConfig) (stat.Connection, error) {
+	request := ConnectRequestFromContext(ctx)
+	if request == nil {
+		return nil, errors.New(`the "naive" transport can only be used by a naive outbound`)
+	}
+
+	session, err := dialH3(ctx, dest, streamSettings)
+	if err != nil {
+		return nil, err
+	}
+
+	stream, err := session.client.OpenRequestStream(ctx)
+	if err != nil {
+		h3Mutex.Lock()
+		for k, v := range h3Sessions {
+			if v == session {
+				delete(h3Sessions, k)
+			}
+		}
+		h3Mutex.Unlock()
+		return nil, errors.New("naive: failed to open an HTTP/3 request stream").Base(err)
+	}
+
+	header := request.Header
+	if header == nil {
+		header = http.Header{}
+	}
+	// Proto must stay empty: quic-go reads a non-empty Proto on a CONNECT as a
+	// request for Extended CONNECT (RFC 8441), which is a different exchange.
+	httpRequest := (&http.Request{
+		Method: http.MethodConnect,
+		URL:    &url.URL{Host: request.Authority},
+		Host:   request.Authority,
+		Header: header,
+	}).WithContext(ctx)
+
+	if err := stream.SendRequestHeader(httpRequest); err != nil {
+		stream.Close()
+		return nil, errors.New("naive: failed to send CONNECT").Base(err)
+	}
+	response, err := stream.ReadResponse()
+	if err != nil {
+		stream.Close()
+		return nil, errors.New("naive: failed to read the CONNECT response").Base(err)
+	}
+	request.StatusCode = response.StatusCode
+	request.Response = response.Header
+
+	return &streamConn{
+		stream: stream,
+		local:  session.quicConn.LocalAddr(),
+		remote: session.quicConn.RemoteAddr(),
+	}, nil
+}
+
+func init() {
+	common.Must(internet.RegisterTransportDialer(protocolName, Dial))
+}
diff --git a/transport/internet/naive/hub.go b/transport/internet/naive/hub.go
new file mode 100644
index 00000000..6c958837
--- /dev/null
+++ b/transport/internet/naive/hub.go
@@ -0,0 +1,248 @@
+package naive
+
+import (
+	"context"
+	gotls "crypto/tls"
+	"net/http"
+	"slices"
+	"time"
+
+	"github.com/apernet/quic-go"
+	"github.com/apernet/quic-go/http3"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion/bbr"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	"github.com/xtls/xray-core/transport/internet/tls"
+)
+
+// Listener owns the sockets a naive inbound listens on. It is deliberately dumb
+// about the naive protocol itself: TCP conns go straight to the inbound, and
+// every HTTP/3 request is handed over as a conn so that the very same handler
+// in proxy/naive serves h1, h2 and h3.
+type Listener struct {
+	ctx     context.Context
+	addConn internet.ConnHandler
+
+	tcpListener net.Listener
+
+	pktConn    net.PacketConn
+	h3listener *quic.EarlyListener
+	h3server   *http3.Server
+}
+
+type h3Handler struct {
+	addConn internet.ConnHandler
+	local   net.Addr
+}
+
+func (h *h3Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	conn := newRequestConn(w, r, h.local)
+	h.addConn(conn)
+	// The stream worker closes the conn when Process() returns; only then may
+	// this handler return, because that is what ends the HTTP/3 response.
+	<-conn.Wait()
+}
+
+// tcpTLSConfig strips h3 from the negotiated ALPN set so that one tlsSettings
+// block can drive both wires of a "tcp,udp" inbound.
+func tcpTLSConfig(c *gotls.Config) *gotls.Config {
+	if c == nil {
+		return nil
+	}
+	protos := make([]string, 0, len(c.NextProtos))
+	for _, p := range c.NextProtos {
+		if p != "h3" {
+			protos = append(protos, p)
+		}
+	}
+	if len(protos) == 0 {
+		protos = []string{"h2", "http/1.1"}
+	}
+	c.NextProtos = protos
+	return c
+}
+
+func (l *Listener) keepAcceptingTCP() {
+	for {
+		conn, err := l.tcpListener.Accept()
+		if err != nil {
+			errors.LogInfoInner(l.ctx, err, "naive TCP listener closed")
+			return
+		}
+		l.addConn(conn.(stat.Connection))
+	}
+}
+
+func (l *Listener) keepAcceptingQUIC(quicParams *internet.QuicParams) {
+	for {
+		conn, err := l.h3listener.Accept(context.Background())
+		if err != nil {
+			errors.LogInfoInner(l.ctx, err, "naive QUIC listener closed")
+			return
+		}
+
+		switch quicParams.Congestion {
+		case "force-brutal":
+			congestion.UseBrutal(conn, quicParams.BrutalUp, quicParams.BrutalDisableLossCompensation)
+		case "reno":
+		default:
+			congestion.UseBBR(conn, bbr.Profile(quicParams.BbrProfile))
+		}
+
+		go func(conn *quic.Conn) {
+			if err := l.h3server.ServeQUICConn(conn); err != nil {
+				errors.LogDebugInner(l.ctx, err, "naive HTTP/3 connection ended")
+			}
+			_ = conn.CloseWithError(closeErrCodeOK, "")
+		}(conn)
+	}
+}
+
+// Listen implements internet.ListenFunc.
+func Listen(ctx context.Context, address net.Address, port net.Port, streamSettings *internet.MemoryStreamConfig, addConn internet.ConnHandler) (internet.Listener, error) {
+	config, _ := streamSettings.ProtocolSettings.(*Config)
+	mode := config.mode()
+
+	l := &Listener{
+		ctx:     ctx,
+		addConn: addConn,
+	}
+
+	tlsSettings := tls.ConfigFromStreamSettings(streamSettings)
+
+	if mode.tcp {
+		var listener net.Listener
+		var err error
+		tcpAddr := &net.TCPAddr{
+			IP:   address.IP(),
+			Port: int(port),
+		}
+		if streamSettings.FinalMask != nil {
+			listener, err = streamSettings.FinalMask.Listen(ctx, tcpAddr)
+		} else {
+			listener, err = internet.ListenSystem(ctx, tcpAddr, streamSettings.SocketSettings)
+		}
+		if err != nil {
+			return nil, errors.New("failed to listen TCP for naive on ", address, ":", port).Base(err)
+		}
+		if tlsSettings != nil {
+			if tlsConfig := tcpTLSConfig(tlsSettings.GetTLSConfig()); tlsConfig != nil {
+				listener = gotls.NewListener(listener, tlsConfig)
+			}
+		}
+		l.tcpListener = listener
+		errors.LogInfo(ctx, "listening TCP for naive (h1/h2) on ", address, ":", port)
+		go l.keepAcceptingTCP()
+	}
+
+	// QUIC has no cleartext mode. Rather than refuse the whole inbound, drop the
+	// h3 wire, since serving h2c behind a TLS-terminating front proxy is a real
+	// deployment and there is nothing wrong with it.
+	if mode.udp && tlsSettings == nil {
+		if !mode.tcp {
+			return nil, errors.New("naive over HTTP/3 requires TLS")
+		}
+		errors.LogWarning(ctx, "naive: no TLS configured, serving HTTP/2 only (HTTP/3 needs TLS)")
+		mode.udp = false
+	}
+
+	if mode.udp {
+		var raw net.PacketConn
+		var err error
+		udpAddr := &net.UDPAddr{
+			IP:   address.IP(),
+			Port: int(port),
+		}
+		if streamSettings.FinalMask != nil {
+			raw, err = streamSettings.FinalMask.ListenPacket(context.Background(), udpAddr)
+		} else {
+			raw, err = internet.ListenSystemPacket(context.Background(), udpAddr, streamSettings.SocketSettings)
+		}
+		if err != nil {
+			l.Close()
+			return nil, errors.New("failed to listen UDP for naive on ", address, ":", port).Base(err)
+		}
+		l.pktConn = raw
+
+		quicParams := streamSettings.QuicParams
+		if quicParams == nil {
+			quicParams = &internet.QuicParams{
+				BbrProfile: string(bbr.ProfileStandard),
+			}
+		}
+		quicConfig := &quic.Config{
+			InitialStreamReceiveWindow:     quicParams.InitStreamReceiveWindow,
+			MaxStreamReceiveWindow:         quicParams.MaxStreamReceiveWindow,
+			InitialConnectionReceiveWindow: quicParams.InitConnReceiveWindow,
+			MaxConnectionReceiveWindow:     quicParams.MaxConnReceiveWindow,
+			MaxIdleTimeout:                 time.Duration(quicParams.MaxIdleTimeout) * time.Second,
+			MaxIncomingStreams:             quicParams.MaxIncomingStreams,
+			DisablePathMTUDiscovery:        quicParams.DisablePathMtuDiscovery,
+		}
+		if quicConfig.MaxIdleTimeout == 0 {
+			quicConfig.MaxIdleTimeout = 30 * time.Second
+		}
+		if quicConfig.MaxIncomingStreams == 0 {
+			quicConfig.MaxIncomingStreams = 1024
+		}
+
+		h3TLS := tlsSettings.GetTLSConfig()
+		if !slices.Contains(h3TLS.NextProtos, http3.NextProtoH3) {
+			h3TLS.NextProtos = []string{http3.NextProtoH3}
+		}
+
+		l.h3listener, err = quic.ListenEarly(l.pktConn, h3TLS, quicConfig)
+		if err != nil {
+			l.Close()
+			return nil, errors.New("failed to listen QUIC for naive on ", address, ":", port).Base(err)
+		}
+		l.h3server = &http3.Server{
+			Handler: &h3Handler{addConn: addConn, local: l.h3listener.Addr()},
+		}
+		errors.LogInfo(ctx, "listening QUIC for naive (h3) on ", address, ":", port)
+		go l.keepAcceptingQUIC(quicParams)
+	}
+
+	return l, nil
+}
+
+// Addr implements internet.Listener.
+func (l *Listener) Addr() net.Addr {
+	if l.tcpListener != nil {
+		return l.tcpListener.Addr()
+	}
+	if l.h3listener != nil {
+		return l.h3listener.Addr()
+	}
+	return nil
+}
+
+// Close implements internet.Listener.
+func (l *Listener) Close() error {
+	var err error
+	if l.tcpListener != nil {
+		err = l.tcpListener.Close()
+	}
+	if l.h3server != nil {
+		if e := l.h3server.Close(); e != nil && err == nil {
+			err = e
+		}
+	}
+	if l.h3listener != nil {
+		if e := l.h3listener.Close(); e != nil && err == nil {
+			err = e
+		}
+	}
+	if l.pktConn != nil {
+		_ = l.pktConn.Close()
+	}
+	return err
+}
+
+func init() {
+	common.Must(internet.RegisterTransportListener(protocolName, Listen))
+}
diff --git a/transport/internet/tuic/client.go b/transport/internet/tuic/client.go
new file mode 100644
index 00000000..e505731c
--- /dev/null
+++ b/transport/internet/tuic/client.go
@@ -0,0 +1,319 @@
+package tuic
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"io"
+	stdnet "net"
+	"reflect"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/apernet/quic-go"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion"
+	"github.com/xtls/xray-core/transport/internet/hysteria/congestion/bbr"
+	"github.com/xtls/xray-core/transport/internet/tuic/congestion/reno"
+)
+
+// Client owns one authenticated QUIC connection to a TUIC server and multiplexes
+// every Connect stream and UDP association over it, redialing when it dies.
+type Client struct {
+	destination  net.Destination
+	tlsConfig    *tls.Config
+	socketConfig *internet.SocketConfig
+	settings     ClientSettings
+
+	access sync.Mutex
+	conn   *clientConnection
+}
+
+func NewClient(destination net.Destination, tlsConfig *tls.Config, socketConfig *internet.SocketConfig, settings ClientSettings) *Client {
+	if settings.Heartbeat <= 0 {
+		settings.Heartbeat = 10 * time.Second
+	}
+	return &Client{
+		destination:  destination,
+		tlsConfig:    tlsConfig,
+		socketConfig: socketConfig,
+		settings:     settings,
+	}
+}
+
+type clientConnection struct {
+	quicConn   *quic.Conn
+	rawConn    io.Closer
+	ctx        context.Context
+	cancel     context.CancelCauseFunc
+	udpAccess  sync.RWMutex
+	udpConnMap map[uint16]*udpPacketConn
+	sessionID  atomic.Uint32
+	closeOnce  sync.Once
+}
+
+func (c *clientConnection) closeWithError(err error) {
+	c.closeOnce.Do(func() {
+		c.cancel(err)
+		_ = c.quicConn.CloseWithError(0, "")
+		if c.rawConn != nil {
+			_ = c.rawConn.Close()
+		}
+	})
+}
+
+func (c *clientConnection) alive() bool {
+	select {
+	case <-c.ctx.Done():
+		return false
+	default:
+		return true
+	}
+}
+
+// OpenStream returns an authenticated TUIC Connect stream. The caller writes the
+// [version, command, address] header itself, the same split the server assumes.
+func (c *Client) OpenStream(ctx context.Context) (stdnet.Conn, error) {
+	conn, err := c.connection(ctx)
+	if err != nil {
+		return nil, err
+	}
+	stream, err := conn.quicConn.OpenStreamSync(ctx)
+	if err != nil {
+		conn.closeWithError(err)
+		return nil, errors.New("failed to open TUIC stream").Base(err)
+	}
+	return &streamConn{
+		Stream: stream,
+		local:  conn.quicConn.LocalAddr(),
+		remote: conn.quicConn.RemoteAddr(),
+	}, nil
+}
+
+// OpenPacketConn allocates a UDP association on the shared connection.
+func (c *Client) OpenPacketConn(ctx context.Context) (PacketConn, error) {
+	conn, err := c.connection(ctx)
+	if err != nil {
+		return nil, err
+	}
+	sessionID := uint16(conn.sessionID.Add(1))
+	packetConn := newUDPPacketConn(conn.ctx, conn.quicConn, c.settings.UDPStream, false, nil, func() {
+		conn.udpAccess.Lock()
+		delete(conn.udpConnMap, sessionID)
+		conn.udpAccess.Unlock()
+	})
+	packetConn.sessionID = sessionID
+	conn.udpAccess.Lock()
+	conn.udpConnMap[sessionID] = packetConn
+	conn.udpAccess.Unlock()
+	return packetConn, nil
+}
+
+func (c *Client) Close() error {
+	c.access.Lock()
+	conn := c.conn
+	c.conn = nil
+	c.access.Unlock()
+	if conn != nil {
+		conn.closeWithError(stdnet.ErrClosed)
+	}
+	return nil
+}
+
+func (c *Client) connection(ctx context.Context) (*clientConnection, error) {
+	c.access.Lock()
+	defer c.access.Unlock()
+	if c.conn != nil && c.conn.alive() {
+		return c.conn, nil
+	}
+	conn, err := c.dial(ctx)
+	if err != nil {
+		return nil, err
+	}
+	c.conn = conn
+	return conn, nil
+}
+
+func (c *Client) dial(ctx context.Context) (*clientConnection, error) {
+	// The destination reaches us as TCP so that internet.Dial selects this
+	// transport; the wire underneath QUIC is of course UDP.
+	udpDestination := c.destination
+	udpDestination.Network = net.Network_UDP
+
+	raw, err := internet.DialSystem(ctx, udpDestination, c.socketConfig)
+	if err != nil {
+		return nil, errors.New("failed to dial TUIC server").Base(err)
+	}
+
+	var (
+		packetConn stdnet.PacketConn
+		remote     stdnet.Addr
+	)
+	switch typed := raw.(type) {
+	case *net.PacketConnWrapper:
+		packetConn = typed.PacketConn
+		remote = typed.RemoteAddr()
+	case *net.UDPConn:
+		packetConn = typed
+		remote = typed.RemoteAddr()
+	default:
+		_ = raw.Close()
+		return nil, errors.New("TUIC requires a UDP connection, got ", reflect.TypeOf(typed))
+	}
+
+	quicConfig := &quic.Config{
+		DisablePathMTUDiscovery:        !(runtime.GOOS == "windows" || runtime.GOOS == "linux" || runtime.GOOS == "android" || runtime.GOOS == "darwin"),
+		EnableDatagrams:                true,
+		MaxIncomingStreams:             1 << 60,
+		MaxIncomingUniStreams:          1 << 60,
+		MaxDatagramFrameSize:           1200,
+		AssumePeerMaxDatagramFrameSize: 1200,
+		DisablePathManager:             true,
+	}
+
+	var quicConn *quic.Conn
+	if c.settings.ZeroRTTHandshake {
+		quicConn, err = quic.DialEarly(ctx, packetConn, remote, c.tlsConfig, quicConfig)
+	} else {
+		quicConn, err = quic.Dial(ctx, packetConn, remote, c.tlsConfig, quicConfig)
+	}
+	if err != nil {
+		_ = raw.Close()
+		return nil, errors.New("failed to establish TUIC QUIC connection").Base(err)
+	}
+
+	c.setCongestion(quicConn)
+
+	connCtx, cancel := context.WithCancelCause(context.Background())
+	conn := &clientConnection{
+		quicConn:   quicConn,
+		rawConn:    raw,
+		ctx:        connCtx,
+		cancel:     cancel,
+		udpConnMap: make(map[uint16]*udpPacketConn),
+	}
+
+	if err := c.authenticate(quicConn); err != nil {
+		conn.closeWithError(err)
+		return nil, errors.New("TUIC authentication failed").Base(err)
+	}
+
+	// Both carriers are always accepted on the read side; which one the server
+	// picks follows the association, not a client setting.
+	go c.loopUniStreams(conn)
+	go c.loopMessages(conn)
+	go c.loopHeartbeats(conn)
+
+	errors.LogInfo(ctx, "TUIC connected to ", c.destination)
+	return conn, nil
+}
+
+func (c *Client) setCongestion(conn *quic.Conn) {
+	switch c.settings.CongestionControl {
+	case "bbr":
+		congestion.UseBBR(conn, bbr.ProfileStandard)
+	case "new_reno":
+		conn.SetCongestionControl(reno.NewSender(bbr.GetInitialPacketSize(conn.RemoteAddr())))
+	default:
+		// "cubic": quic-go's built-in default.
+	}
+}
+
+func (c *Client) authenticate(quicConn *quic.Conn) error {
+	stream, err := quicConn.OpenUniStream()
+	if err != nil {
+		return errors.New("failed to open TUIC auth stream").Base(err)
+	}
+	defer stream.Close()
+
+	tlsState := quicConn.ConnectionState().TLS
+	token, err := tlsState.ExportKeyingMaterial(string(c.settings.UUID[:]), []byte(c.settings.Password), 32)
+	if err != nil {
+		return errors.New("failed to export keying material").Base(err)
+	}
+
+	request := bytes.NewBuffer(make([]byte, 0, authenticateLen))
+	request.WriteByte(tuicVersion)
+	request.WriteByte(commandAuthenticate)
+	request.Write(c.settings.UUID[:])
+	request.Write(token)
+	_, err = stream.Write(request.Bytes())
+	return err
+}
+
+func (c *Client) loopHeartbeats(conn *clientConnection) {
+	ticker := time.NewTicker(c.settings.Heartbeat)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-conn.ctx.Done():
+			return
+		case <-ticker.C:
+			if err := conn.quicConn.SendDatagram([]byte{tuicVersion, commandHeartbeat}); err != nil {
+				conn.closeWithError(errors.New("send heartbeat").Base(err))
+				return
+			}
+		}
+	}
+}
+
+func (c *Client) loopMessages(conn *clientConnection) {
+	for {
+		data, err := conn.quicConn.ReceiveDatagram(conn.ctx)
+		if err != nil {
+			conn.closeWithError(err)
+			return
+		}
+		if len(data) < 2 || data[0] != tuicVersion {
+			continue
+		}
+		switch data[1] {
+		case commandPacket:
+			message := new(udpMessage)
+			if err := decodeUDPMessage(message, data[2:]); err != nil {
+				continue
+			}
+			c.deliver(conn, message)
+		case commandHeartbeat:
+		}
+	}
+}
+
+func (c *Client) loopUniStreams(conn *clientConnection) {
+	for {
+		stream, err := conn.quicConn.AcceptUniStream(conn.ctx)
+		if err != nil {
+			return
+		}
+		go func(stream *quic.ReceiveStream) {
+			defer stream.CancelRead(0)
+			header := make([]byte, 2)
+			if _, err := io.ReadFull(stream, header); err != nil {
+				return
+			}
+			if header[0] != tuicVersion || header[1] != commandPacket {
+				return
+			}
+			message := new(udpMessage)
+			if err := readUDPMessage(message, stream); err != nil {
+				return
+			}
+			c.deliver(conn, message)
+		}(stream)
+	}
+}
+
+func (c *Client) deliver(conn *clientConnection, message *udpMessage) {
+	conn.udpAccess.RLock()
+	packetConn := conn.udpConnMap[message.sessionID]
+	conn.udpAccess.RUnlock()
+	if packetConn == nil {
+		return
+	}
+	packetConn.inputPacket(message)
+}
