+}
+
+func init() { file_proxy_anytls_config_proto_init() }
+func file_proxy_anytls_config_proto_init() {
+	if File_proxy_anytls_config_proto != nil {
+		return
+	}
+	type x struct{}
+	out := protoimpl.TypeBuilder{
