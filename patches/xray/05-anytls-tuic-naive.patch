+			}
+			if statusCode != 0 {
+				w.WriteHeader(int(statusCode))
+			} else {
+				w.WriteHeader(http.StatusOK)
+			}
+			_, _ = w.Write([]byte(content))
+		}), nil
+	default:
+		return nil, errors.New("naive: unknown masquerade type ", typ)
+	}
