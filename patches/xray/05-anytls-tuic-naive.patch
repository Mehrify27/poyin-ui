+		defer resp.Body.Close()
+		b, _ := io.ReadAll(resp.Body)
+		if resp.StatusCode != 200 || string(b) != masqBody {
+			t.Fatalf("h1 GET / = %d %q, want the masquerade page", resp.StatusCode, b)
+		}
+	})
+
+	t.Run("407 over h1", func(t *testing.T) {
+		conn, err := net.Dial("tcp", addr)
+		common.Must(err)
+		defer conn.Close()
+		fmt.Fprintf(conn, "CONNECT %s HTTP/1.1\r\nHost: %s\r\n\r\n", target.Listener.Addr(), target.Listener.Addr())
+		resp, err := http.ReadResponse(bufio.NewReader(conn), nil)
+		if err != nil {
+			t.Fatalf("read response: %v", err)
+		}
+		if resp.StatusCode != http.StatusProxyAuthRequired {
+			t.Fatalf("status %d, want 407", resp.StatusCode)
+		}
+		if !strings.HasPrefix(resp.Header.Get("Proxy-Authenticate"), "Basic realm=") {
+			t.Fatal("h1 407 is missing its Proxy-Authenticate challenge")
+		}
+	})
+
+	t.Run("padded tunnel over h1", func(t *testing.T) {
+		conn, err := net.Dial("tcp", addr)
+		common.Must(err)
+		defer conn.Close()
+		targetAddr := target.Listener.Addr().String()
+		fmt.Fprintf(conn, "CONNECT %s HTTP/1.1\r\nHost: %s\r\n", targetAddr, targetAddr)
+		fmt.Fprintf(conn, "Proxy-Authorization: Basic %s\r\n", base64.StdEncoding.EncodeToString([]byte(testEmail+":"+testPassword)))
+		fmt.Fprintf(conn, "padding: %s\r\npadding-type-request: 1, 0\r\n\r\n", naive.RequestPaddingHeader())
+
+		reader := bufio.NewReader(conn)
+		resp, err := http.ReadResponse(reader, nil)
+		if err != nil {
+			t.Fatalf("read CONNECT response: %v", err)
+		}
+		if resp.StatusCode != 200 {
+			t.Fatalf("status %d, want 200", resp.StatusCode)
+		}
+		if got := resp.Header.Get("padding-type-reply"); got != "1" {
+			t.Fatalf("h1 padding-type-reply = %q, want \"1\"", got)
+		}
+		exercisePaddedTunnel(t, reader, conn, targetAddr)
+	})
+}
+
+// TestConnectAuthorityHeaderWins pins the Cronet quirk: when -connect-authority
+// and :authority disagree, the former decides. sing-box's naive outbound relies
+// on this, so ignoring it would lock those clients out.
+func TestConnectAuthorityHeaderWins(t *testing.T) {
+	target := targetServer(t)
+	port := tcpserver.PickPort()
+	addr := fmt.Sprintf("127.0.0.1:%d", port)
+
+	startXray(t, `{
+		"log": {"loglevel": "error"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": `+fmt.Sprint(port)+`,
+			"protocol": "naive",
+			"settings": `+naiveSettingsJSON()+`
+		}],
+		"outbounds": [{"protocol": "freedom"}]
+	}`)
+	time.Sleep(300 * time.Millisecond)
+
+	targetAddr := target.Listener.Addr().String()
+	cc := dialH2(t, addr, nil)
+
+	body, writer := io.Pipe()
+	defer writer.Close()
+	header := connectHeader(targetAddr, true)
+	// :authority points somewhere unroutable; only the header can save us.
+	const decoy = "192.0.2.1:9"
+	req := &http.Request{
+		Method: http.MethodConnect,
+		URL:    mustURL("https://" + decoy),
+		Host:   decoy,
+		Header: header,
+		Body:   body,
+	}
+	resp, err := cc.RoundTrip(req)
+	if err != nil {
+		t.Fatalf("CONNECT: %v", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 {
+		t.Fatalf("status %d, want 200", resp.StatusCode)
+	}
+	exercisePaddedTunnel(t, resp.Body, writer, targetAddr)
+}
+
+// naiveOutboundClientConfig builds the exact JSON the panel emits for a naive
+// outbound, so a panel-side shape change that breaks dialing fails here.
+func naiveOutboundClientConfig(clientPort, serverPort uint32, network, streamNetwork, alpn, pinHex, fingerprint string) string {
+	fp := ""
+	if fingerprint != "" {
+		fp = `"fingerprint": "` + fingerprint + `",`
+	}
+	return `{
+		"log": {"loglevel": "error"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": ` + fmt.Sprint(clientPort) + `,
+			"protocol": "http",
+			"settings": {}
+		}],
+		"outbounds": [{
+			"protocol": "naive",
+			"settings": {
+				"address": "127.0.0.1",
+				"port": ` + fmt.Sprint(serverPort) + `,
+				"email": "` + testEmail + `",
+				"password": "` + testPassword + `",
+				"network": "` + network + `"
+			},
+			"streamSettings": {
+				"network": "` + streamNetwork + `",
+				"security": "tls",
+				"tlsSettings": {
+					"serverName": "localhost",
+					` + fp + `
+					"alpn": ["` + alpn + `"],
+					"pinnedPeerCertSha256": "` + pinHex + `"
+				}
+			}
+		}]
+	}`
+}
+
+// TestPanelOutboundShapes pins the outbound config the panel writes, including
+// the case where settings.network and streamSettings.network disagree:
+// NormalizeNaiveOutboundStream is what makes that harmless rather than a dead
+// outbound whose only symptom is a CONNECT that never happens.
+func TestPanelOutboundShapes(t *testing.T) {
+	cases := []struct {
+		name          string
+		network       string
+		streamNetwork string
+		alpn          string
+		fingerprint   string
+	}{
+		{"h2 as the panel writes it", "tcp", "tcp", "h2", ""},
+		{"h3 as the panel writes it", "udp", "naive", "h3", ""},
+		{"h3 with the stream left on tcp", "udp", "tcp", "h3", ""},
+		{"h2 with the stream set to naive", "tcp", "naive", "h2", ""},
+		{"h2 with the uTLS chrome fingerprint", "tcp", "tcp", "h2", "chrome"},
+		// A dialer opens one wire, so anything that is not udp-only means h2.
+		// Omitted and "tcp,udp" both reach that through ParseNetwork reading
+		// them as BOTH, not as tcp; a hand-edited config or a share-link import
+		// is the likeliest source of either.
+		{"h2 with network omitted", "", "tcp", "h2", ""},
+		{"h2 with network tcp,udp", "tcp,udp", "tcp", "h2", ""},
+		{"h2 with network omitted and the stream set to naive", "", "naive", "h2", ""},
+	}
+
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			target := targetServer(t)
+			serverPort := tcpserver.PickPort()
+			clientPort := tcpserver.PickPort()
+			certPEM, keyPEM, pinHex := selfSignedPEM(t)
+
+			startXray(t, `{
+				"log": {"loglevel": "error"},
+				"inbounds": [{
+					"listen": "127.0.0.1",
+					"port": `+fmt.Sprint(serverPort)+`,
+					"protocol": "naive",
+					"settings": `+naiveSettingsJSON()+`,
+					"streamSettings": {
+						"network": "tcp",
+						"security": "tls",
+						"tlsSettings": {
+							"serverName": "localhost",
+							"certificates": [{
+								"certificate": `+jsonList(strings.Split(strings.TrimRight(certPEM, "\n"), "\n"))+`,
+								"key": `+jsonList(strings.Split(strings.TrimRight(keyPEM, "\n"), "\n"))+`
+							}]
+						}
+					}
+				}],
+				"outbounds": [{"protocol": "freedom"}]
+			}`)
+			startXray(t, naiveOutboundClientConfig(uint32(clientPort), uint32(serverPort), c.network, c.streamNetwork, c.alpn, pinHex, c.fingerprint))
+			time.Sleep(500 * time.Millisecond)
+
+			client := &http.Client{
+				Transport: &http.Transport{
+					Proxy: http.ProxyURL(mustURL(fmt.Sprintf("http://127.0.0.1:%d", clientPort))),
+				},
+				Timeout: 15 * time.Second,
+			}
+			resp, err := client.Get(target.URL)
+			if err != nil {
+				t.Fatalf("request through the naive outbound: %v", err)
+			}
+			defer resp.Body.Close()
+			b, _ := io.ReadAll(resp.Body)
+			if string(b) != "tunnelled ok" {
+				t.Fatalf("body %q, want the target's response", b)
+			}
+		})
+	}
+}
diff --git a/proxy/naive/padding.go b/proxy/naive/padding.go
new file mode 100644
index 00000000..86e55159
--- /dev/null
+++ b/proxy/naive/padding.go
@@ -0,0 +1,251 @@
+package naive
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// NaiveProxy's padding layer. There is exactly one wire variant upstream:
+//
+//	kNone = 0, kVariant1 = 1
+//
+// Variant1 frames the first eight writes of each direction (counted
+// independently) as
+//
+//	uint16 payload_size (big endian) | uint8 padding_size | payload | zeros
+//
+// and then falls through to raw bytes. Payloads are chunked at 65535 because
+// that is what payload_size can express.
+const (
+	PaddingTypeNone     = 0
+	PaddingTypeVariant1 = 1
+
+	firstPaddings  = 8
+	maxPaddingSize = 255
+	maxPayloadSize = 65535
+)
+
+const (
+	headerPadding            = "padding"
+	headerPaddingTypeRequest = "padding-type-request"
+	headerPaddingTypeReply   = "padding-type-reply"
+	// headerConnectAuthority is a Cronet quirk: naiveproxy's client puts the
+	// real CONNECT target here as well, and some clients (sing-box's naive
+	// outbound among them) only put it here. Read it first.
+	headerConnectAuthority = "-connect-authority"
+
+	headerProxyAuthorization = "Proxy-Authorization"
+	headerProxyAuthenticate  = "Proxy-Authenticate"
+)
+
+// paddingHeaderChars is the alphabet naiveproxy fills the leading bytes of a
+// padding header with; the remainder is '~'.
+const paddingHeaderChars = "!#$()+<>?@[]^`{}"
+
+var errInvalidResponse = errors.New("naive: invalid response")
+
+func randomBytes(n int) []byte {
+	b := make([]byte, n)
+	if _, err := rand.Read(b); err != nil {
+		panic(err)
+	}
+	return b
+}
+
+// randomInt returns a value in [min, max].
+func randomInt(min, max int) int {
+	if max <= min {
+		return min
+	}
+	b := randomBytes(2)
+	return min + int(binary.BigEndian.Uint16(b))%(max-min+1)
+}
+
+// PaddingHeaderValue builds a padding header of a random length in [min, max].
+func PaddingHeaderValue(min, max int) string {
+	n := randomInt(min, max)
+	b := make([]byte, n)
+	pick := randomBytes(n)
+	for i := 0; i < n; i++ {
+		if i < len(paddingHeaderChars) {
+			b[i] = paddingHeaderChars[int(pick[i])%len(paddingHeaderChars)]
+		} else {
+			b[i] = '~'
+		}
+	}
+	return string(b)
+}
+
+// RequestPaddingHeader is what a client sends (16-32 bytes).
+func RequestPaddingHeader() string { return PaddingHeaderValue(16, 32) }
+
+// ReplyPaddingHeader is what a server answers with (30-62 bytes).
+func ReplyPaddingHeader() string { return PaddingHeaderValue(30, 62) }
+
+func parsePaddingTypeList(v string) []int {
+	var out []int
+	for _, part := range strings.Split(v, ",") {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		n, err := strconv.Atoi(part)
+		if err != nil {
+			continue
+		}
+		out = append(out, n)
+	}
+	return out
+}
+
+// NegotiateServerPadding picks the padding variant for an inbound request.
+// A client that only sends "padding:" (and no padding-type-request) is a legacy
+// client and means Variant1.
+func NegotiateServerPadding(h http.Header) int {
+	if v := h.Get(headerPaddingTypeRequest); v != "" {
+		for _, t := range parsePaddingTypeList(v) {
+			switch t {
+			case PaddingTypeVariant1, PaddingTypeNone:
+				return t
+			}
+		}
+		return PaddingTypeNone
+	}
+	if h.Get(headerPadding) != "" {
+		return PaddingTypeVariant1
+	}
+	return PaddingTypeNone
+}
+
+// NegotiateClientPadding resolves the variant from a server's 200 response.
+// A reply header wins; otherwise a bare "padding:" implies Variant1; a response
+// carrying neither means no padding. Anything unparseable is a protocol error,
+// which is what naiveproxy reports as ERR_INVALID_RESPONSE.
+func NegotiateClientPadding(h http.Header) (int, error) {
+	if v := h.Get(headerPaddingTypeReply); v != "" {
+		t, err := strconv.Atoi(strings.TrimSpace(v))
+		if err != nil {
+			return 0, errInvalidResponse
+		}
+		switch t {
+		case PaddingTypeNone, PaddingTypeVariant1:
+			return t, nil
+		}
+		return 0, errInvalidResponse
+	}
+	if h.Get(headerPadding) != "" {
+		return PaddingTypeVariant1, nil
+	}
+	return PaddingTypeNone, nil
+}
+
+// paddingReader unwraps Variant1 framing.
+type paddingReader struct {
+	reader io.Reader
+	frames int
+
+	payloadRemain int
+	padRemain     int
+	header        [3]byte
+}
+
+func newPaddingReader(r io.Reader) io.Reader { return &paddingReader{reader: r} }
+
+func (r *paddingReader) Read(p []byte) (int, error) {
+	for {
+		if r.payloadRemain > 0 {
+			n := len(p)
+			if n > r.payloadRemain {
+				n = r.payloadRemain
+			}
+			n, err := r.reader.Read(p[:n])
+			r.payloadRemain -= n
+			return n, err
+		}
+		if r.padRemain > 0 {
+			if _, err := io.CopyN(io.Discard, r.reader, int64(r.padRemain)); err != nil {
+				return 0, err
+			}
+			r.padRemain = 0
+		}
+		if r.frames >= firstPaddings {
+			return r.reader.Read(p)
+		}
+		if _, err := io.ReadFull(r.reader, r.header[:]); err != nil {
+			return 0, err
+		}
+		r.frames++
+		r.payloadRemain = int(binary.BigEndian.Uint16(r.header[:2]))
+		r.padRemain = int(r.header[2])
+	}
+}
+
+// paddingWriter applies Variant1 framing. It reports the number of *payload*
+// bytes consumed, not the number of wire bytes, so it composes with
+// io.WriteAll-style callers such as buf.WriteAllBytes.
+type paddingWriter struct {
+	writer io.Writer
+	frames int
+	buf    []byte
+}
+
+func newPaddingWriter(w io.Writer) io.Writer { return &paddingWriter{writer: w} }
+
+func (w *paddingWriter) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		if w.frames >= firstPaddings {
+			n, err := w.writer.Write(p)
+			return total + n, err
+		}
+		chunk := p
+		if len(chunk) > maxPayloadSize {
+			chunk = chunk[:maxPayloadSize]
+		}
+		padSize := int(randomBytes(1)[0]) % (maxPaddingSize + 1)
+		size := 3 + len(chunk) + padSize
+		if cap(w.buf) < size {
+			w.buf = make([]byte, size)
+		}
+		b := w.buf[:size]
+		binary.BigEndian.PutUint16(b[0:2], uint16(len(chunk)))
+		b[2] = byte(padSize)
+		copy(b[3:], chunk)
+		for i := 3 + len(chunk); i < size; i++ {
+			b[i] = 0
+		}
+		if _, err := w.writer.Write(b); err != nil {
+			return total, err
+		}
+		w.frames++
+		total += len(chunk)
+		p = p[len(chunk):]
+	}
+	return total, nil
+}
+
+// flushWriter pushes every write out of the HTTP/2 or HTTP/3 response buffer.
+// Without it a tunnel stalls behind net/http's 4 KiB body buffer.
+type flushWriter struct {
+	writer  io.Writer
+	flusher http.Flusher
+}
+
+func newFlushWriter(w http.ResponseWriter) io.Writer {
+	f, _ := w.(http.Flusher)
+	return &flushWriter{writer: w, flusher: f}
+}
+
+func (w *flushWriter) Write(p []byte) (int, error) {
+	n, err := w.writer.Write(p)
+	if w.flusher != nil {
+		w.flusher.Flush()
+	}
+	return n, err
+}
diff --git a/proxy/naive/padding_test.go b/proxy/naive/padding_test.go
new file mode 100644
index 00000000..ea639f88
--- /dev/null
+++ b/proxy/naive/padding_test.go
@@ -0,0 +1,188 @@
+package naive
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"net/http"
+	"testing"
+)
+
+// TestVariant1WireFormat pins the exact framing: the first eight writes carry a
+// 3-byte header and trailing zeros, the ninth is raw.
+func TestVariant1WireFormat(t *testing.T) {
+	var wire bytes.Buffer
+	w := newPaddingWriter(&wire)
+
+	payloads := [][]byte{
+		[]byte("one"), []byte("two"), []byte("three"), []byte("four"),
+		[]byte("five"), []byte("six"), []byte("seven"), []byte("eight"),
+		[]byte("nine"), []byte("ten"),
+	}
+	for _, p := range payloads {
+		n, err := w.Write(p)
+		if err != nil {
+			t.Fatalf("write: %v", err)
+		}
+		if n != len(p) {
+			t.Fatalf("write returned %d payload bytes, want %d", n, len(p))
+		}
+	}
+
+	b := wire.Bytes()
+	for i := 0; i < firstPaddings; i++ {
+		if len(b) < 3 {
+			t.Fatalf("frame %d: truncated", i)
+		}
+		size := int(binary.BigEndian.Uint16(b[0:2]))
+		pad := int(b[2])
+		if size != len(payloads[i]) {
+			t.Fatalf("frame %d: payload_size %d, want %d", i, size, len(payloads[i]))
+		}
+		if len(b) < 3+size+pad {
+			t.Fatalf("frame %d: truncated body", i)
+		}
+		if !bytes.Equal(b[3:3+size], payloads[i]) {
+			t.Fatalf("frame %d: payload %q, want %q", i, b[3:3+size], payloads[i])
+		}
+		for _, c := range b[3+size : 3+size+pad] {
+			if c != 0 {
+				t.Fatalf("frame %d: padding is not zero-filled", i)
+			}
+		}
+		b = b[3+size+pad:]
+	}
+	if !bytes.Equal(b, []byte("nineten")) {
+		t.Fatalf("after %d frames the stream must be raw, got %q", firstPaddings, b)
+	}
+}
+
+// TestVariant1RoundTrip drives the reader from the writer's output, including a
+// payload larger than one frame can express.
+func TestVariant1RoundTrip(t *testing.T) {
+	var wire bytes.Buffer
+	w := newPaddingWriter(&wire)
+
+	big := bytes.Repeat([]byte("x"), maxPayloadSize+1234)
+	writes := [][]byte{
+		[]byte("hello"), {}, []byte("world"), big,
+		[]byte("a"), []byte("b"), []byte("c"), []byte("d"),
+		[]byte("e"), []byte("raw tail"),
+	}
+	var want []byte
+	for _, p := range writes {
+		if _, err := w.Write(p); err != nil {
+			t.Fatalf("write: %v", err)
+		}
+		want = append(want, p...)
+	}
+
+	got, err := io.ReadAll(newPaddingReader(bytes.NewReader(wire.Bytes())))
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Fatalf("round trip mismatch: got %d bytes, want %d", len(got), len(want))
+	}
+}
+
+// TestPaddingReaderHonoursSmallBuffers checks the reader's state machine when a
+// frame spans several Read calls.
+func TestPaddingReaderHonoursSmallBuffers(t *testing.T) {
+	var wire bytes.Buffer
+	w := newPaddingWriter(&wire)
+	payload := bytes.Repeat([]byte("abcdefgh"), 1000)
+	if _, err := w.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := w.Write([]byte("tail")); err != nil {
+		t.Fatal(err)
+	}
+
+	r := newPaddingReader(bytes.NewReader(wire.Bytes()))
+	var got []byte
+	buf := make([]byte, 7)
+	for {
+		n, err := r.Read(buf)
+		got = append(got, buf[:n]...)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("read: %v", err)
+		}
+	}
+	if want := append(append([]byte{}, payload...), []byte("tail")...); !bytes.Equal(got, want) {
+		t.Fatalf("mismatch: got %d bytes, want %d", len(got), len(want))
+	}
+}
+
+func TestNegotiateServerPadding(t *testing.T) {
+	cases := []struct {
+		name   string
+		header http.Header
+		want   int
+	}{
+		{"variant1 preferred", http.Header{"Padding-Type-Request": {"1, 0"}, "Padding": {"abc"}}, PaddingTypeVariant1},
+		{"none preferred", http.Header{"Padding-Type-Request": {"0, 1"}}, PaddingTypeNone},
+		{"unknown types fall back to none", http.Header{"Padding-Type-Request": {"7, 9"}}, PaddingTypeNone},
+		{"legacy client infers variant1", http.Header{"Padding": {"abc"}}, PaddingTypeVariant1},
+		{"nothing means nothing", http.Header{}, PaddingTypeNone},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := NegotiateServerPadding(c.header); got != c.want {
+				t.Fatalf("got %d, want %d", got, c.want)
+			}
+		})
+	}
+}
+
+func TestNegotiateClientPadding(t *testing.T) {
+	if got, err := NegotiateClientPadding(http.Header{"Padding-Type-Reply": {"1"}}); err != nil || got != PaddingTypeVariant1 {
+		t.Fatalf("reply wins: got %d, %v", got, err)
+	}
+	if got, err := NegotiateClientPadding(http.Header{"Padding-Type-Reply": {"0"}, "Padding": {"abc"}}); err != nil || got != PaddingTypeNone {
+		t.Fatalf("an explicit 0 reply wins over a padding header: got %d, %v", got, err)
+	}
+	if got, err := NegotiateClientPadding(http.Header{"Padding": {"abc"}}); err != nil || got != PaddingTypeVariant1 {
+		t.Fatalf("legacy inference: got %d, %v", got, err)
+	}
+	if got, err := NegotiateClientPadding(http.Header{}); err != nil || got != PaddingTypeNone {
+		t.Fatalf("no padding: got %d, %v", got, err)
+	}
+	if _, err := NegotiateClientPadding(http.Header{"Padding-Type-Reply": {"banana"}}); err == nil {
+		t.Fatal("an unparseable reply must be an error")
+	}
+	if _, err := NegotiateClientPadding(http.Header{"Padding-Type-Reply": {"9"}}); err == nil {
+		t.Fatal("an unknown variant must be an error")
+	}
+}
+
+func TestPaddingHeaderShape(t *testing.T) {
+	for i := 0; i < 200; i++ {
+		v := RequestPaddingHeader()
+		if len(v) < 16 || len(v) > 32 {
+			t.Fatalf("request padding length %d out of [16,32]", len(v))
+		}
+		checkAlphabet(t, v)
+		v = ReplyPaddingHeader()
+		if len(v) < 30 || len(v) > 62 {
+			t.Fatalf("reply padding length %d out of [30,62]", len(v))
+		}
+		checkAlphabet(t, v)
+	}
+}
+
+func checkAlphabet(t *testing.T, v string) {
+	t.Helper()
+	for i := 0; i < len(v); i++ {
+		if i < len(paddingHeaderChars) {
+			if !bytes.ContainsRune([]byte(paddingHeaderChars), rune(v[i])) {
+				t.Fatalf("byte %d of %q is not from the padding alphabet", i, v)
+			}
+		} else if v[i] != '~' {
+			t.Fatalf("byte %d of %q must be '~'", i, v)
+		}
+	}
+}
diff --git a/proxy/naive/server.go b/proxy/naive/server.go
new file mode 100644
index 00000000..6c97ee5f
--- /dev/null
+++ b/proxy/naive/server.go
@@ -0,0 +1,424 @@
+package naive
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/log"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	http_proto "github.com/xtls/xray-core/common/protocol/http"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/policy"
+	"github.com/xtls/xray-core/features/routing"
+	"github.com/xtls/xray-core/proxy"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet/stat"
+)
+
+var (
+	_ proxy.Inbound     = (*Server)(nil)
+	_ proxy.UserManager = (*Server)(nil)
+)
+
+// httpStreamConn is what transport/internet/naive hands over for an HTTP/3
+// request. It is matched structurally so that the proxy does not have to import
+// the transport.
+type httpStreamConn interface {
+	HTTPRequest() *http.Request
+	HTTPResponseWriter() http.ResponseWriter
+}
+
+// Server is the naive inbound. One Server serves h1, h2 and h3 through a single
+// http.Handler, because CONNECT looks the same on all three once the request
+// headers are parsed.
+type Server struct {
+	config        *ServerConfig
+	validator     *Validator
+	policyManager policy.Manager
+	masquerade    http.Handler
+	realm         string
+}
+
+// NewServer creates a new naive inbound handler.
+func NewServer(ctx context.Context, config *ServerConfig) (*Server, error) {
+	validator := NewValidator()
+	for _, user := range config.Clients {
+		// Drop the bad account, keep the inbound. Returning an error here makes
+		// Xray refuse the ENTIRE config, so one duplicate Basic username would
+		// take down every unrelated inbound on the box. That has bitten this
+		// fork twice. infra/conf/naive.go screens the same cases earlier; this
+		// is the backstop for accounts that arrive by other routes.
+		u, err := user.ToMemoryUser()
+		if err != nil {
+			errors.LogWarningInner(ctx, err, "naive: dropping client ", user.Email)
+			continue
+		}
+		if err := validator.Add(u); err != nil {
+			errors.LogWarningInner(ctx, err, "naive: dropping client ", user.Email)
+			continue
+		}
+	}
+
+	// Not an error: an inbound may legitimately start empty and get its accounts
+	// hot-added over gRPC. It is worth a warning because the symptom is so
+	// misleading: the port listens, the masquerade serves a working website,
+	// and every CONNECT answers 407, which reads as a broken protocol rather
+	// than as an inbound with nothing to authenticate against.
+	if validator.GetCount() == 0 {
+		errors.LogWarning(ctx, "naive: inbound has no clients, so every CONNECT will be refused with 407 and only the masquerade will answer")
+	}
+
+	masquerade, err := buildMasquerade(config.Masquerade)
+	if err != nil {
+		return nil, err
+	}
+
+	realm := config.Realm
+	if realm == "" {
+		realm = "Proxy"
+	}
+
+	v := core.MustFromContext(ctx)
+	return &Server{
+		config:        config,
+		validator:     validator,
+		policyManager: v.GetFeature(policy.ManagerType()).(policy.Manager),
+		masquerade:    masquerade,
+		realm:         realm,
+	}, nil
+}
+
+// Network implements proxy.Inbound. Both wires are driven by the stream worker:
+// plain TLS/TCP for h1+h2, and transport/internet/naive, which turns every
+// HTTP/3 request into a conn, for h3.
+func (*Server) Network() []net.Network {
+	return []net.Network{net.Network_TCP, net.Network_UNIX}
+}
+
+// AddUser implements proxy.UserManager.
+func (s *Server) AddUser(ctx context.Context, u *protocol.MemoryUser) error {
+	return s.validator.Add(u)
+}
+
+// RemoveUser implements proxy.UserManager.
+func (s *Server) RemoveUser(ctx context.Context, email string) error {
+	return s.validator.Del(email)
+}
+
+// GetUser implements proxy.UserManager.
+func (s *Server) GetUser(ctx context.Context, email string) *protocol.MemoryUser {
+	return s.validator.GetByEmail(email)
+}
+
+// GetUsers implements proxy.UserManager.
+func (s *Server) GetUsers(ctx context.Context) []*protocol.MemoryUser {
+	return s.validator.GetAll()
+}
+
+// GetUsersCount implements proxy.UserManager.
+func (s *Server) GetUsersCount(context.Context) int64 {
+	return s.validator.GetCount()
+}
+
+// Process implements proxy.Inbound.
+func (s *Server) Process(ctx context.Context, network net.Network, conn stat.Connection, dispatcher routing.Dispatcher) error {
+	inbound := session.InboundFromContext(ctx)
+	if inbound != nil {
+		inbound.Name = "naive"
+		inbound.CanSpliceCopy = 3
+		if inbound.User == nil {
+			inbound.User = &protocol.MemoryUser{}
+		}
+	}
+
+	if hc, ok := stat.TryUnwrapStatsConn(conn).(httpStreamConn); ok {
+		s.serve(ctx, hc.HTTPResponseWriter(), hc.HTTPRequest(), dispatcher)
+		return nil
+	}
+
+	return s.serveStream(ctx, conn, dispatcher)
+}
+
+// oneShotListener feeds a single already-accepted conn to net/http, which is
+// what lets an ordinary proxy.Inbound host a real HTTP server. Using net/http
+// (rather than hand-rolling responses) is deliberate: the masquerade must be
+// byte-for-byte a normal web server to an active prober.
+type oneShotListener struct {
+	conn net.Conn
+	ch   chan net.Conn
+}
+
+func newOneShotListener(conn net.Conn) *oneShotListener {
+	l := &oneShotListener{conn: conn, ch: make(chan net.Conn, 1)}
+	l.ch <- conn
+	close(l.ch)
+	return l
+}
+
+func (l *oneShotListener) Accept() (net.Conn, error) {
+	if c, ok := <-l.ch; ok {
+		return c, nil
+	}
+	return nil, io.EOF
+}
+
+func (l *oneShotListener) Close() error   { return nil }
+func (l *oneShotListener) Addr() net.Addr { return l.conn.LocalAddr() }
+
+// trackedConn reports when net/http (or our own CONNECT handler) is finished
+// with the connection, so Process can block for exactly that long.
+type trackedConn struct {
+	stat.Connection
+	done chan struct{}
+	once sync.Once
+}
+
+func (c *trackedConn) Close() error {
+	c.once.Do(func() { close(c.done) })
+	return c.Connection.Close()
+}
+
+func (s *Server) serveStream(ctx context.Context, conn stat.Connection, dispatcher routing.Dispatcher) error {
+	tracked := &trackedConn{Connection: conn, done: make(chan struct{})}
+
+	protocols := new(http.Protocols)
+	protocols.SetHTTP1(true)
+	// The TLS layer is already terminated by the transport, so from net/http's
+	// point of view an ALPN-negotiated h2 client is a prior-knowledge h2c one.
+	protocols.SetUnencryptedHTTP2(true)
+
+	server := &http.Server{
+		Handler:           s.handler(ctx, dispatcher),
+		ReadHeaderTimeout: s.policy().Timeouts.Handshake,
+		IdleTimeout:       s.policy().Timeouts.ConnectionIdle,
+		Protocols:         protocols,
+		BaseContext:       func(net.Listener) context.Context { return ctx },
+	}
+
+	go func() {
+		_ = server.Serve(newOneShotListener(tracked))
+	}()
+
+	select {
+	case <-tracked.done:
+	case <-ctx.Done():
+	}
+	_ = server.Close()
+	return nil
+}
+
+func (s *Server) policy() policy.Session {
+	return s.policyManager.ForLevel(0)
+}
+
+func (s *Server) handler(connCtx context.Context, dispatcher routing.Dispatcher) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		s.serve(connCtx, w, r, dispatcher)
+	})
+}
+
+func parseBasicAuth(auth string) (username, password string, ok bool) {
+	const prefix = "Basic "
+	if len(auth) < len(prefix) || !strings.EqualFold(auth[:len(prefix)], prefix) {
+		return
+	}
+	c, err := base64.StdEncoding.DecodeString(strings.TrimSpace(auth[len(prefix):]))
+	if err != nil {
+		return
+	}
+	cs := string(c)
+	i := strings.IndexByte(cs, ':')
+	if i < 0 {
+		return
+	}
+	return cs[:i], cs[i+1:], true
+}
+
+// connectAuthority resolves the CONNECT target. `-connect-authority` comes
+// first because Cronet puts it there and some clients send nothing else.
+func connectAuthority(r *http.Request) string {
+	if v := r.Header.Get(headerConnectAuthority); v != "" {
+		return v
+	}
+	if r.Host != "" {
+		return r.Host
+	}
+	if r.URL != nil && r.URL.Host != "" {
+		return r.URL.Host
+	}
+	return ""
+}
+
+// serve is the single entry point for h1, h2 and h3.
+func (s *Server) serve(connCtx context.Context, w http.ResponseWriter, r *http.Request, dispatcher routing.Dispatcher) {
+	if !strings.EqualFold(r.Method, http.MethodConnect) {
+		// Everything that is not a proxy request, including naiveproxy's own
+		// preamble GETs, is answered by the masquerade site.
+		s.masquerade.ServeHTTP(w, r)
+		return
+	}
+
+	user := s.authenticate(r)
+	if user == nil {
+		// The challenge is mandatory, not cosmetic: Cronet does not send
+		// credentials pre-emptively and only retries after a 407 that carries
+		// Proxy-Authenticate.
+		w.Header().Set(headerProxyAuthenticate, `Basic realm="`+s.realm+`", charset="UTF-8"`)
+		w.Header().Set("Content-Length", "0")
+		w.WriteHeader(http.StatusProxyAuthRequired)
+		return
+	}
+
+	authority := connectAuthority(r)
+	if authority == "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	dest, err := http_proto.ParseHost(authority, net.Port(443))
+	if err != nil {
+		errors.LogInfoInner(connCtx, err, "naive: malformed CONNECT authority ", authority)
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+
+	paddingType := NegotiateServerPadding(r.Header)
+
+	ctx := s.subContext(connCtx, user)
+	ctx = log.ContextWithAccessMessage(ctx, &log.AccessMessage{
+		From:   r.RemoteAddr,
+		To:     dest,
+		Status: log.AccessAccepted,
+		Reason: "",
+		Email:  user.Email,
+	})
+	errors.LogInfo(ctx, "naive: tunnelling request to ", dest)
+
+	reader, writer, closer, err := s.accept(w, r, paddingType)
+	if err != nil {
+		errors.LogInfoInner(ctx, err, "naive: failed to accept CONNECT")
+		return
+	}
+	if closer != nil {
+		defer closer()
+	}
+
+	if paddingType == PaddingTypeVariant1 {
+		reader = newPaddingReader(reader)
+		writer = newPaddingWriter(writer)
+	}
+
+	if err := dispatcher.DispatchLink(ctx, dest, &transport.Link{
+		Reader: buf.NewReader(reader),
+		Writer: buf.NewWriter(writer),
+	}); err != nil {
+		errors.LogInfoInner(ctx, err, "naive: failed to dispatch request")
+	}
+}
+
+// accept answers 200 and returns the tunnel's two halves. HTTP/1.1 is hijacked
+// (naiveproxy itself considers h1 dead, but a hijack is free and keeps active
+// probers honest); h2 and h3 stream through the request body and the response
+// writer, with an explicit flush on every write.
+func (s *Server) accept(w http.ResponseWriter, r *http.Request, paddingType int) (io.Reader, io.Writer, func(), error) {
+	if r.ProtoMajor == 1 {
+		hijacker, ok := w.(http.Hijacker)
+		if !ok {
+			w.WriteHeader(http.StatusInternalServerError)
+			return nil, nil, nil, errors.New("naive: HTTP/1.1 response is not hijackable")
+		}
+		conn, brw, err := hijacker.Hijack()
+		if err != nil {
+			return nil, nil, nil, errors.New("naive: hijack failed").Base(err)
+		}
+		var response strings.Builder
+		response.WriteString("HTTP/1.1 200 Connection established\r\n")
+		if paddingType == PaddingTypeVariant1 {
+			response.WriteString(headerPadding + ": " + ReplyPaddingHeader() + "\r\n")
+			response.WriteString(headerPaddingTypeReply + ": 1\r\n")
+		}
+		response.WriteString("\r\n")
+		if _, err := brw.WriteString(response.String()); err != nil {
+			conn.Close()
+			return nil, nil, nil, err
+		}
+		if err := brw.Flush(); err != nil {
+			conn.Close()
+			return nil, nil, nil, err
+		}
+		var reader io.Reader = conn
+		if brw.Reader.Buffered() > 0 {
+			reader = io.MultiReader(io.LimitReader(brw.Reader, int64(brw.Reader.Buffered())), conn)
+		}
+		return reader, conn, func() { conn.Close() }, nil
+	}
+
+	if paddingType == PaddingTypeVariant1 {
+		w.Header().Set(headerPadding, ReplyPaddingHeader())
+		w.Header().Set(headerPaddingTypeReply, "1")
+	}
+	w.WriteHeader(http.StatusOK)
+	if f, ok := w.(http.Flusher); ok {
+		f.Flush()
+	}
+	var reader io.Reader = r.Body
+	if reader == nil {
+		reader = strings.NewReader("")
+	}
+	return reader, newFlushWriter(w), nil, nil
+}
+
+func (s *Server) authenticate(r *http.Request) *protocol.MemoryUser {
+	if s.validator.GetCount() == 0 {
+		return nil
+	}
+	username, password, ok := parseBasicAuth(r.Header.Get(headerProxyAuthorization))
+	if !ok {
+		return nil
+	}
+	return s.validator.Get(username, password)
+}
+
+// subContext gives each CONNECT stream its own session, because a single h2 or
+// h3 connection carries many of them. Setting Inbound.User is what wires the
+// stream into per-account statistics, the speed limiter, the IP/device limiter
+// and online detection; CanSpliceCopy = 3 keeps the limiter in the data path.
+//
+// Every one of those keys off user.Email, never off the Basic username the
+// client actually sent. The split is deliberate: the username is only a
+// credential and an account may change it, while the email is the identity the
+// panel's client_traffics rows, quota and expiry are written against. Handing
+// the username down here would silently unhook all of them, with traffic still
+// flowing and nothing logging an error.
+func (s *Server) subContext(ctx context.Context, user *protocol.MemoryUser) context.Context {
+	newContent := session.Content{}
+	if content := session.ContentFromContext(ctx); content != nil {
+		newContent = *content
+		newContent.Attributes = nil
+	}
+	ctx = session.ContextWithContent(ctx, &newContent)
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{}})
+
+	if inbound := session.InboundFromContext(ctx); inbound != nil {
+		newInbound := *inbound
+		newInbound.Name = "naive"
+		newInbound.CanSpliceCopy = 3
+		newInbound.User = user
+		ctx = session.ContextWithInbound(ctx, &newInbound)
+	}
+	return ctx
+}
+
+func init() {
+	common.Must(common.RegisterConfig((*ServerConfig)(nil), func(ctx context.Context, config interface{}) (interface{}, error) {
+		return NewServer(ctx, config.(*ServerConfig))
+	}))
+}
diff --git a/proxy/naive/username_test.go b/proxy/naive/username_test.go
new file mode 100644
index 00000000..d040d275
--- /dev/null
+++ b/proxy/naive/username_test.go
@@ -0,0 +1,399 @@
+package naive_test
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/proxy/naive"
+	tcpserver "github.com/xtls/xray-core/testing/servers/tcp"
+)
+
+// testClient mirrors the shape infra/conf.NaiveUserConfig binds, so these tests
+// exercise the same JSON the panel writes.
+type testClient struct {
+	Email    string `json:"email"`
+	Username string `json:"username,omitempty"`
+	Password string `json:"password"`
+}
+
+func settingsWithClients(clients ...testClient) string {
+	b, err := json.Marshal(clients)
+	if err != nil {
+		panic(err)
+	}
+	return `{"clients": ` + string(b) + `, "network": "tcp", "masquerade": {"type": "404"}}`
+}
+
+// connectStatus runs one CONNECT with an explicit Basic credential and reports
+// the status the inbound answered with. 200 means authenticated, 407 means not.
+func connectStatus(t *testing.T, addr, authority, username, password string) int {
+	t.Helper()
+	cc := dialH2(t, addr, nil)
+	body, writer := io.Pipe()
+	defer writer.Close()
+
+	header := http.Header{}
+	header.Set("Proxy-Authorization", "Basic "+base64.StdEncoding.EncodeToString([]byte(username+":"+password)))
+	header.Set("padding", naive.RequestPaddingHeader())
+	header.Set("padding-type-request", "1, 0")
+	header.Set("-connect-authority", authority)
+
+	resp, err := cc.RoundTrip(&http.Request{
+		Method: http.MethodConnect,
+		URL:    mustURL("https://" + authority),
+		Host:   authority,
+		Header: header,
+		Body:   body,
+	})
+	if err != nil {
+		t.Fatalf("CONNECT round trip: %v", err)
+	}
+	defer resp.Body.Close()
+	return resp.StatusCode
+}
+
+// startNaiveInbound brings up a plaintext h2 naive inbound and returns its
+// address. It fails the test if the config is refused, which is the assertion
+// that carries every "degrades, not fatal" case below.
+func startNaiveInbound(t *testing.T, settings string) string {
+	t.Helper()
+	port := tcpserver.PickPort()
+	startXray(t, `{
+		"log": {"loglevel": "error"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": `+fmt.Sprint(port)+`,
+			"protocol": "naive",
+			"settings": `+settings+`
+		}],
+		"outbounds": [{"protocol": "freedom"}]
+	}`)
+	time.Sleep(300 * time.Millisecond)
+	return fmt.Sprintf("127.0.0.1:%d", port)
+}
+
+// TestBasicUsernameAuth pins the credential semantics: an account with a
+// username authenticates under it and no longer under its email, and an account
+// without one keeps authenticating under its email exactly as it did before the
+// field existed.
+func TestBasicUsernameAuth(t *testing.T) {
+	target := targetServer(t)
+	addr := startNaiveInbound(t, settingsWithClients(
+		testClient{Email: "alice@example.com", Username: "alice-vpn", Password: "hunter2"},
+		testClient{Email: "bob@example.com", Password: "secret"},
+	))
+	authority := target.Listener.Addr().String()
+
+	cases := []struct {
+		name     string
+		username string
+		password string
+		want     int
+	}{
+		{"username authenticates", "alice-vpn", "hunter2", http.StatusOK},
+		{"username with the wrong password is refused", "alice-vpn", "nope", http.StatusProxyAuthRequired},
+		{"the email of a client that has a username no longer authenticates", "alice@example.com", "hunter2", http.StatusProxyAuthRequired},
+		{"a client with no username still authenticates by email", "bob@example.com", "secret", http.StatusOK},
+		{"email with the wrong password is refused", "bob@example.com", "nope", http.StatusProxyAuthRequired},
+		{"one client's username with another's password is refused", "alice-vpn", "secret", http.StatusProxyAuthRequired},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := connectStatus(t, addr, authority, tc.username, tc.password); got != tc.want {
+				t.Fatalf("CONNECT as %q returned %d, want %d", tc.username, got, tc.want)
+			}
+		})
+	}
+}
+
+// TestDuplicateUsernameDegrades is the outage guard. Two clients answering to
+// one Basic username must cost exactly those clients, never the config: an
+// error out of Build makes Xray refuse every inbound on the box.
+func TestDuplicateUsernameDegrades(t *testing.T) {
+	target := targetServer(t)
+	addr := startNaiveInbound(t, settingsWithClients(
+		testClient{Email: "first@example.com", Username: "shared", Password: "first-pass"},
+		testClient{Email: "second@example.com", Username: "shared", Password: "second-pass"},
+		testClient{Email: "carol@example.com", Username: "carol-vpn", Password: "carol-pass"},
+	))
+	authority := target.Listener.Addr().String()
+
+	// Reaching here at all proves the config loaded. The unrelated account must
+	// be untouched by its neighbours' collision.
+	if got := connectStatus(t, addr, authority, "carol-vpn", "carol-pass"); got != http.StatusOK {
+		t.Fatalf("the unrelated client returned %d, want 200: a duplicate username must not cost other accounts", got)
+	}
+	if got := connectStatus(t, addr, authority, "shared", "first-pass"); got != http.StatusOK {
+		t.Fatalf("the first claimant of a duplicate username returned %d, want 200", got)
+	}
+	if got := connectStatus(t, addr, authority, "shared", "second-pass"); got != http.StatusProxyAuthRequired {
+		t.Fatalf("the second claimant of a duplicate username returned %d, want 407: it must be dropped", got)
+	}
+}
+
+// TestColonInUsernameDegrades covers the other skip case. A colon cannot be
+// expressed in HTTP Basic, so the account is unusable either way; what matters
+// is that it is dropped rather than taking the config down with it.
+func TestColonInUsernameDegrades(t *testing.T) {
+	target := targetServer(t)
+	addr := startNaiveInbound(t, settingsWithClients(
+		testClient{Email: "bad@example.com", Username: "has:colon", Password: "bad-pass"},
+		testClient{Email: "good@example.com", Username: "good-vpn", Password: "good-pass"},
+	))
+	authority := target.Listener.Addr().String()
+
+	if got := connectStatus(t, addr, authority, "good-vpn", "good-pass"); got != http.StatusOK {
+		t.Fatalf("the good client returned %d, want 200: a colon in a neighbour's username must not cost it", got)
+	}
+	// "has:colon" splits into user "has" and password "colon", and the dropped
+	// account cannot be reached under any spelling.
+	for _, username := range []string{"has:colon", "has", "bad@example.com"} {
+		if got := connectStatus(t, addr, authority, username, "bad-pass"); got != http.StatusProxyAuthRequired {
+			t.Fatalf("CONNECT as %q returned %d, want 407: the client must have been dropped", username, got)
+		}
+	}
+}
+
+// TestClientWithNoCredentialIdentityDegrades: a client with neither a username
+// nor an email has no Basic username at all. Same rule, drop it and keep going.
+func TestClientWithNoCredentialIdentityDegrades(t *testing.T) {
+	target := targetServer(t)
+	addr := startNaiveInbound(t, settingsWithClients(
+		testClient{Password: "orphan-pass"},
+		testClient{Email: "dave@example.com", Password: "dave-pass"},
+	))
+	authority := target.Listener.Addr().String()
+
+	if got := connectStatus(t, addr, authority, "dave@example.com", "dave-pass"); got != http.StatusOK {
+		t.Fatalf("the good client returned %d, want 200", got)
+	}
+	if got := connectStatus(t, addr, authority, "", "orphan-pass"); got != http.StatusProxyAuthRequired {
+		t.Fatalf("a client with no username and no email returned %d, want 407", got)
+	}
+}
+
+// TestOutboundSendsUsername proves the outbound puts the username on the wire.
+// The two sides deliberately disagree about the email, so an outbound that
+// still sent the email would fail to authenticate.
+func TestOutboundSendsUsername(t *testing.T) {
+	target := targetServer(t)
+	serverPort := tcpserver.PickPort()
+	clientPort := tcpserver.PickPort()
+
+	startXray(t, `{
+		"log": {"loglevel": "error"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": `+fmt.Sprint(serverPort)+`,
+			"protocol": "naive",
+			"settings": `+settingsWithClients(testClient{
+		Email:    "server-side@example.com",
+		Username: "shared-username",
+		Password: "shared-pass",
+	})+`
+		}],
+		"outbounds": [{"protocol": "freedom"}]
+	}`)
+
+	startXray(t, `{
+		"log": {"loglevel": "error"},
+		"inbounds": [{
+			"listen": "127.0.0.1",
+			"port": `+fmt.Sprint(clientPort)+`,
+			"protocol": "http",
+			"settings": {}
+		}],
+		"outbounds": [{
+			"protocol": "naive",
+			"settings": {
+				"address": "127.0.0.1",
+				"port": `+fmt.Sprint(serverPort)+`,
+				"email": "client-side@example.com",
+				"username": "shared-username",
+				"password": "shared-pass",
+				"network": "tcp"
+			}
+		}]
+	}`)
+	time.Sleep(500 * time.Millisecond)
+
+	client := &http.Client{
+		Transport: &http.Transport{
+			Proxy: http.ProxyURL(mustURL(fmt.Sprintf("http://127.0.0.1:%d", clientPort))),
+		},
+		Timeout: 10 * time.Second,
+	}
+	resp, err := client.Get(target.URL)
+	if err != nil {
+		t.Fatalf("request through the naive outbound: %v", err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	if string(b) != "tunnelled ok" {
+		t.Fatalf("body %q, want the target's response: the outbound did not send the username", b)
+	}
+}
+
+func naiveUser(email, username, password string) *protocol.MemoryUser {
+	return &protocol.MemoryUser{
+		Email:   email,
+		Account: &naive.MemoryAccount{Username: username, Password: password},
+	}
+}
+
+// TestValidatorIndexing covers the two indexes directly, including the one the
+// UserManager remove path needs.
+func TestValidatorIndexing(t *testing.T) {
+	v := naive.NewValidator()
+	withUsername := naiveUser("alice@example.com", "alice-vpn", "hunter2")
+	byEmailOnly := naiveUser("bob@example.com", "", "secret")
+	for _, u := range []*protocol.MemoryUser{withUsername, byEmailOnly} {
+		if err := v.Add(u); err != nil {
+			t.Fatalf("Add(%s): %v", u.Email, err)
+		}
+	}
+
+	if got := v.Get("alice-vpn", "hunter2"); got != withUsername {
+		t.Fatal("Get by username did not return the user")
+	}
+	if got := v.Get("alice@example.com", "hunter2"); got != nil {
+		t.Fatal("the email of a user that has a username must not authenticate")
+	}
+	if got := v.Get("bob@example.com", "secret"); got != byEmailOnly {
+		t.Fatal("a user with no username must still authenticate by email")
+	}
+	if got := v.Get("alice-vpn", "wrong"); got != nil {
+		t.Fatal("the wrong password must not authenticate")
+	}
+	// The UserManager removes by email, so both users must be reachable that
+	// way whichever name they authenticate under.
+	if got := v.GetByEmail("alice@example.com"); got != withUsername {
+		t.Fatal("GetByEmail must find a user that authenticates by username")
+	}
+	if got := v.GetByEmail("bob@example.com"); got != byEmailOnly {
+		t.Fatal("GetByEmail must find a user that authenticates by email")
+	}
+	if v.GetCount() != 2 {
+		t.Fatalf("GetCount = %d, want 2", v.GetCount())
+	}
+
+	// Del must clear both indexes, or a removed account keeps authenticating.
+	if err := v.Del("alice@example.com"); err != nil {
+		t.Fatalf("Del: %v", err)
+	}
+	if got := v.Get("alice-vpn", "hunter2"); got != nil {
+		t.Fatal("a deleted user still authenticates: Del left the username index behind")
+	}
+	if got := v.GetByEmail("alice@example.com"); got != nil {
+		t.Fatal("a deleted user is still in the email index")
+	}
+	if v.GetCount() != 1 {
+		t.Fatalf("GetCount after Del = %d, want 1", v.GetCount())
+	}
+}
+
+func TestValidatorAddRejects(t *testing.T) {
+	cases := []struct {
+		name string
+		user *protocol.MemoryUser
+	}{
+		{"a colon in the username", naiveUser("x@example.com", "has:colon", "pass")},
+		{"neither a username nor an email", naiveUser("", "", "pass")},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			v := naive.NewValidator()
+			if err := v.Add(tc.user); err == nil {
+				t.Fatal("Add accepted the account, want an error for the hot-add caller")
+			}
+			if v.GetCount() != 0 {
+				t.Fatalf("GetCount = %d, want 0: the rejected account was still indexed", v.GetCount())
+			}
+		})
+	}
+
+	t.Run("a duplicate Basic username", func(t *testing.T) {
+		v := naive.NewValidator()
+		first := naiveUser("first@example.com", "shared", "first-pass")
+		if err := v.Add(first); err != nil {
+			t.Fatalf("Add: %v", err)
+		}
+		if err := v.Add(naiveUser("second@example.com", "shared", "second-pass")); err == nil {
+			t.Fatal("Add accepted a duplicate Basic username")
+		}
+		if got := v.Get("shared", "first-pass"); got != first {
+			t.Fatal("the rejected duplicate displaced the account that was already there")
+		}
+		if got := v.GetByEmail("second@example.com"); got != nil {
+			t.Fatal("the rejected duplicate was left in the email index")
+		}
+	})
+
+	t.Run("a username colliding with another account's email", func(t *testing.T) {
+		v := naive.NewValidator()
+		if err := v.Add(naiveUser("alice@example.com", "", "first-pass")); err != nil {
+			t.Fatalf("Add: %v", err)
+		}
+		// The fallback means an email occupies the same namespace as a username.
+		if err := v.Add(naiveUser("bob@example.com", "alice@example.com", "second-pass")); err == nil {
+			t.Fatal("Add accepted a username that collides with another account's email")
+		}
+	})
+}
+
+// TestBasicUsername pins the fallback that both the inbound and the outbound
+// resolve credentials through.
+func TestBasicUsername(t *testing.T) {
+	cases := []struct {
+		name string
+		user *protocol.MemoryUser
+		want string
+	}{
+		{"username wins", naiveUser("alice@example.com", "alice-vpn", "p"), "alice-vpn"},
+		{"empty username falls back to the email", naiveUser("alice@example.com", "", "p"), "alice@example.com"},
+		{"no account at all falls back to the email", &protocol.MemoryUser{Email: "alice@example.com"}, "alice@example.com"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := naive.BasicUsername(tc.user); got != tc.want {
+				t.Fatalf("BasicUsername = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestAccountRoundTrip guards the proto field: a username that does not survive
+// AsAccount/ToProto would authenticate in tests and silently fall back to the
+// email in a real config, which is loaded through the serialized form.
+func TestAccountRoundTrip(t *testing.T) {
+	account, err := (&naive.Account{Password: "hunter2", Username: "alice-vpn"}).AsAccount()
+	if err != nil {
+		t.Fatalf("AsAccount: %v", err)
+	}
+	memory, ok := account.(*naive.MemoryAccount)
+	if !ok {
+		t.Fatalf("AsAccount returned %T, want *naive.MemoryAccount", account)
+	}
+	if memory.Username != "alice-vpn" || memory.Password != "hunter2" {
+		t.Fatalf("AsAccount lost a field: %+v", memory)
+	}
+	back, ok := memory.ToProto().(*naive.Account)
+	if !ok {
+		t.Fatal("ToProto did not return a *naive.Account")
+	}
+	if back.Username != "alice-vpn" || back.Password != "hunter2" {
+		t.Fatalf("ToProto lost a field: %+v", back)
+	}
+	if !memory.Equals(&naive.MemoryAccount{Password: "hunter2", Username: "alice-vpn"}) {
+		t.Fatal("Equals is false for an identical account")
+	}
+	if memory.Equals(&naive.MemoryAccount{Password: "hunter2"}) {
+		t.Fatal("Equals ignores the username, so two different credentials compare equal")
+	}
+}
