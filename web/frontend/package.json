{
  "name": "vpn-ui-frontend",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:export": "node scripts/export-i18n.mjs",
    "i18n:check": "node scripts/verify-i18n.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "dev": "npm run i18n:export && vite",
    "type-check": "vue-tsc --noEmit",
    "build": "npm run i18n:export && npm run i18n:check && vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-rounded": "^5.3.9",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/vazirmatn": "^5.2.6",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "smol-toml": "^1.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
